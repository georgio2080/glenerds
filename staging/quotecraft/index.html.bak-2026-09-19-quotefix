/* ---------- import / export ---------- */
function exportJSON(){
  var blob = new Blob([JSON.stringify(state,null,2)],{type:"application/json"});
  var a = el("a",{href:URL.createObjectURL(blob),download:"quotecraft-backup-"+todayISO()+".json"});
  document.body.appendChild(a);
  a.click();
  setTimeout(function(){ URL.revokeObjectURL(a.href); a.remove(); }, 500);
}
function importJSON(file){
  var rd = new FileReader();
  rd.onload = function(){
    try{
      var parsed = JSON.parse(String(rd.result));
      var clean = sanitizeState(parsed);
      if(!clean || (clean.quotes.length===0 && clean.skipped>0 && !clean.business.name)){
        alert("No valid QuoteCraft records found in that file. Nothing was changed.");
        return;
      }
      if(!confirm("Replace ALL current data with this backup? ("+clean.quotes.length+" quotes, "+clean.skipped+" records skipped)")) return;
      state = clean;
      state.nextNum = Math.max(clean.nextNum, 1);
      cur.quoteId = null;
      save(); renderAll(); showView("list");
      alert("Import complete: "+clean.quotes.length+" quotes restored ("+clean.skipped+" skipped).");
    }catch(e){ alert("Could not read that file as JSON. Nothing was changed."); }
  };
  rd.readAsText(file);
}

/* ---------- theme ---------- */
var THEME_KEY = "quotecraft.theme.v1";
function setTheme(mode){
  document.documentElement.setAttribute("data-theme", mode);
  var btn = document.getElementById("theme-toggle");
  btn.textContent = "Dark mode: " + (mode === "dark" ? "on" : "off");
  btn.setAttribute("aria-pressed", mode === "dark" ? "true" : "false");
  try{ window.localStorage.setItem(THEME_KEY, mode); }catch(e){}
}
function initTheme(){
  var saved = null;
  try{ saved = window.localStorage.getItem(THEME_KEY); }catch(e){}
  if(saved === "dark" || saved === "light") setTheme(saved);
  else setTheme(window.matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light");
}

/* ---------- editor field binding ---------- */
function bindEditor(){
  var q = getQuote(cur.quoteId);
  if(!q) return;
  q.customer = cleanText(document.getElementById("f-cust-name").value, MAX.text);
  q.contact = cleanText(document.getElementById("f-cust-contact").value, MAX.contact);
  var d = document.getElementById("f-quote-date").value;
  if(/^\d{4}-\d{2}-\d{2}$/.test(d)) q.date = d;
  var vu = document.getElementById("f-valid-until").value;
  q.validUntil = /^\d{4}-\d{2}-\d{2}$/.test(vu) ? vu : "";
  var st = document.getElementById("f-status").value;
  if(STATUSES.indexOf(st) >= 0) q.status = st;
  var dt = document.getElementById("f-disc-type").value;
  q.discountType = (dt === "percent" || dt === "flat") ? dt : "none";
  var dv = Number(document.getElementById("f-disc-value").value);
  q.discountValue = Number.isFinite(dv) && dv >= 0 ? dv : 0;
  var tr = Number(document.getElementById("f-tax-rate").value);
  q.taxRate = Number.isFinite(tr) && tr >= 0 ? Math.min(tr,100) : 0;
  q.terms = cleanText(document.getElementById("f-terms").value, MAX.terms);
  save();
  renderTotals(q);
}
function addOrSaveItem(){
  var q = getQuote(cur.quoteId);
  if(!q) return;
  var err = document.getElementById("ni-err");
  err.textContent = "";
  var desc = document.getElementById("ni-desc").value.trim();
  var qtyN = Number(document.getElementById("ni-qty").value);
  var priceC = toCents(document.getElementById("ni-price").value);
  if(!desc){ err.textContent = "Description is required."; return; }
  if(desc.length > MAX.desc){ err.textContent = "Description is too long (200 max)."; return; }
  if(!Number.isFinite(qtyN) || qtyN < 0){ err.textContent = "Quantity must be 0 or more."; return; }
  if(priceC === null || priceC < 0){ err.textContent = "Unit price must be 0 or more."; return; }
  var taxable = document.getElementById("ni-taxable").checked;
  var btn = document.getElementById("btn-add-item");
  var editId = btn.dataset.editId;
  if(editId){
    var it = null;
    q.items.forEach(function(x){ if(x.id===editId) it = x; });
    if(it){ it.desc = desc; it.qty = qtyN; it.unitCents = priceC; it.taxable = taxable; }
    delete btn.dataset.editId;
    btn.textContent = "Add item";
  }else{
    q.items.push({ id: uid(), desc: desc, qty: qtyN, unitCents: priceC, taxable: taxable });
  }
  document.getElementById("ni-desc").value = "";
  document.getElementById("ni-qty").value = "";
  document.getElementById("ni-price").value = "";
  document.getElementById("ni-taxable").checked = true;
  save(); renderItems(q); renderTotals(q);
}

/* ---------- misc ---------- */
function newQuote(){
  var q = {
    id: uid(), num: state.nextNum++, date: todayISO(), validUntil: "",
    customer: "", contact: "", status: "Draft", items: [],
    discountType: "none", discountValue: 0, taxRate: 0, terms: ""
  };
  state.quotes.push(q);
  save(); renderList();
  openQuote(q.id);
}
function renderAll(){
  renderList();
  var b = state.business;
  document.getElementById("b-name").value = b.name;
  document.getElementById("b-phone").value = b.phone;
  document.getElementById("b-email").value = b.email;
  document.getElementById("b-tagline").value = b.tagline;
  if(cur.view === "edit" && cur.quoteId){
    var q = getQuote(cur.quoteId);
    if(q) openQuote(q.id); else { cur.quoteId = null; showView("list"); }
  }
}

/* ---------- events ---------- */
function bind(){
  document.getElementById("theme-toggle").addEventListener("click", function(){
    setTheme(document.documentElement.getAttribute("data-theme") === "dark" ? "light" : "dark");
  });
  var tabs = [["tab-quotes","list"],["tab-business","business"],["tab-data","data"]];
  tabs.forEach(function(p){
    document.getElementById(p[0]).addEventListener("click", function(){ showView(p[1]); });
  });
  document.getElementById("btn-new-quote").addEventListener("click", newQuote);
  document.getElementById("btn-back-list").addEventListener("click", function(){
    bindEditor(); renderList(); showView("list");
  });
  ["f-cust-name","f-cust-contact","f-quote-date","f-valid-until","f-status",
   "f-disc-type","f-disc-value","f-tax-rate","f-terms"].forEach(function(id){
    var n = document.getElementById(id);
    n.addEventListener("change", bindEditor);
    n.addEventListener("input", bindEditor);
  });
  document.getElementById("btn-add-item").addEventListener("click", addOrSaveItem);
  document.getElementById("btn-delete-quote").addEventListener("click", function(){
    var q = getQuote(cur.quoteId);
    if(!q) return;
    if(!confirm("Delete quote "+qnum(q.num)+"? This cannot be undone.")) return;
    state.quotes = state.quotes.filter(function(x){ return x.id !== q.id; });
    cur.quoteId = null;
    save(); renderList(); showView("list");
  });
  document.getElementById("btn-print").addEventListener("click", function(){
    bindEditor();
    var q = getQuote(cur.quoteId);
    if(!q) return;
    buildPrintView(q);
    window.print();
  });
  ["b-name","b-phone","b-email","b-tagline"].forEach(function(id){
    document.getElementById(id).addEventListener("input", function(){
      var b = state.business;
      b.name = cleanText(document.getElementById("b-name").value, MAX.text);
      b.phone = cleanText(document.getElementById("b-phone").value, 40);
      b.email = cleanText(document.getElementById("b-email").value, MAX.text);
      b.tagline = cleanText(document.getElementById("b-tagline").value, MAX.tagline);
      save();
    });
  });
  document.getElementById("btn-export").addEventListener("click", exportJSON);
  document.getElementById("btn-import").addEventListener("click", function(){
    document.getElementById("file-import").click();
  });
  document.getElementById("file-import").addEventListener("change", function(e){
    if(e.target.files && e.target.files[0]) importJSON(e.target.files[0]);
    e.target.value = "";
  });
  document.getElementById("btn-demo").addEventListener("click", function(){
    if(state.quotes.length && !confirm("Replace current data with demo data?")) return;
    loadDemo();
  });
  document.getElementById("btn-clear").addEventListener("click", function(){
    if(!confirm("Delete ALL data — every quote and your business profile?")) return;
    state = { business:{name:"",phone:"",email:"",tagline:""}, quotes:[], nextNum:1 };
    cur.quoteId = null;
    save(); renderAll(); showView("list");
  });
}

/* ---------- init ---------- */
initTheme();
initState();
bind();
renderAll();
if(!storageOK){
  var n = document.getElementById("storage-notice");
  n.hidden = false;
  n.textContent = "Browser storage is unavailable — your data will be kept only until this tab closes.";
}
showView("list");
})();
