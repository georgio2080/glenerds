<script>

"use strict";
/* ---------- theme ---------- */
const root=document.documentElement, themeBtn=document.getElementById('themeBtn'),
      themeUse=document.getElementById('themeUse'), themeLabel=document.getElementById('themeLabel');
function setTheme(t){root.setAttribute('data-theme',t);try{localStorage.setItem('gradeplan-theme',t);}catch(e){}themeUse.setAttribute('href',t==='dark'?'#g-i-sun':'#g-i-moon');themeLabel.textContent=t==='dark'?'Light':'Dark';}
(function(){let t=root.getAttribute('data-theme');if(t!=='dark'&&t!=='light'){try{t=localStorage.getItem('gradeplan-theme');}catch(e){t=null;}}if(t!=='dark'&&t!=='light'){t=(window.matchMedia&&window.matchMedia('(prefers-color-scheme: dark)').matches)?'dark':'light';}setTheme(t);})();
themeBtn.addEventListener('click',()=>setTheme(root.getAttribute('data-theme')==='dark'?'light':'dark'));

/* ---------- tabs ---------- */
const tabBtns=[...document.querySelectorAll('.g-tab')];
function showTab(name){tabBtns.forEach(b=>{const on=b.dataset.tab===name;b.setAttribute('aria-selected',on);document.getElementById('tab-'+b.dataset.tab).hidden=!on;});try{localStorage.setItem('gradeplan-tab',name);}catch(e){}}
tabBtns.forEach(b=>b.addEventListener('click',()=>showTab(b.dataset.tab)));

/* ---------- helpers ---------- */
const $=id=>document.getElementById(id);
const r2=x=>Math.round(x*100)/100;
function num(v){const n=parseFloat(v);return isFinite(n)?n:NaN;}
function showErr(id,msg){const e=$(id);if(msg){e.textContent=msg;e.classList.add('show');}else{e.textContent='';e.classList.remove('show');}}

/* ---------- FINAL SOLVER ---------- */
const fCur=$('f-cur'),fGoal=$('f-goal'),fWt=$('f-wt');
function calcFinal(){
  showErr('f-err','');
  const c=num(fCur.value),d=num(fGoal.value),w=num(fWt.value);
  if(isNaN(c)||c<0||c>100)return showErr('f-err','Current grade must be between 0 and 100.'),$ ('f-res').classList.remove('show');
  if(isNaN(d)||d<0||d>100)return showErr('f-err','Desired grade must be between 0 and 100.'),$ ('f-res').classList.remove('show');
  if(isNaN(w)||w<=0||w>100)return showErr('f-err','Final weight must be more than 0 and at most 100.'),$ ('f-res').classList.remove('show');
  const wf=w/100, need=(d-(1-wf)*c)/wf;
  const maxScore=(1-wf)*c+wf*100, minScore=(1-wf)*c;
  const big=$('f-big'),ver=$('f-verdict');
  if(need>100){
    big.textContent='Not possible';
    ver.innerHTML='<span class="g-verdict g-verdict-bad">Even a perfect 100% on the final only gets you to '+r2(maxScore)+'%.</span> Consider aiming for '+r2(maxScore)+'% instead, or ask about extra credit.';
  }else if(need<0){
    big.textContent='Already guaranteed';
    ver.innerHTML='<span class="g-verdict g-verdict-good">You keep your goal even with a 0% on the final (floor: '+r2(minScore)+'% if you skip it entirely).</span>';
  }else{
    big.textContent=r2(need)+'% needed';
    ver.innerHTML='You need <b>'+r2(need)+'%</b> on the final to finish with <b>'+r2(d)+'%</b> in the course.';
  }
  $('f-work').textContent='required = (desired − (1 − w) × current) ÷ w\nrequired = ('+d+' − (1 − '+r2(wf)+') × '+c+') ÷ '+r2(wf)+'\nrequired = ('+d+' − '+r2((1-wf)*c)+') ÷ '+r2(wf)+' = '+r2(need)+'%';
  $('f-res').classList.add('show');
  save();
}
[fCur,fGoal,fWt].forEach(i=>i.addEventListener('input',calcFinal));

/* ---------- COURSE GRADE ---------- */
const cRows=$('c-rows');
function cRow(name,wt,sc){
  const d=document.createElement('div');d.className='rowline';
  d.innerHTML='<input type="text" placeholder="Category (e.g. Homework)" aria-label="Category name" maxlength="40">'+
    '<input type="number" placeholder="Weight %" aria-label="Weight percent" min="0" max="100" step="0.01" inputmode="decimal">'+
    '<input type="number" placeholder="Score %" aria-label="Score percent" min="0" max="100" step="0.01" inputmode="decimal">'+
    '<button class="rm" type="button" aria-label="Remove category"><svg class="g-icon g-icon-sm" aria-hidden="true"><use href="#g-i-trash"/></svg></button>';
  const ins=d.querySelectorAll('input');
  if(name!==undefined)ins[0].value=name; if(wt!==undefined)ins[1].value=wt; if(sc!==undefined)ins[2].value=sc;
  ins.forEach(i=>i.addEventListener('input',calcCourse));
  d.querySelector('.rm').addEventListener('click',()=>{d.remove();calcCourse();});
  return d;
}
function calcCourse(){
  showErr('c-err','');
  const rows=[...cRows.querySelectorAll('.rowline')];
  let tw=0,ts=0,lines=[],ok=false;
  for(const r of rows){
    const ins=r.querySelectorAll('input');
    const name=(ins[0].value||'Category').trim()||'Category';
    const w=num(ins[1].value),s=num(ins[2].value);
    if(isNaN(w)||isNaN(s))continue;
    if(w<0||w>100)return showErr('c-err','Weights must be between 0 and 100.'),$ ('c-res').classList.remove('show');
    if(s<0||s>100)return showErr('c-err','Scores must be between 0 and 100.'),$ ('c-res').classList.remove('show');
    ok=true;tw+=w;ts+=w*s;lines.push('  '+name+': '+w+'% × '+s+'% = '+r2(w*s));
  }
  if(!ok)return $('c-res').classList.remove('show');
  if(tw===0)return showErr('c-err','Total weight is 0 — add weights to your categories.'),$ ('c-res').classList.remove('show');
  const avg=ts/tw;
  $('c-big').textContent=r2(avg)+'%';
  $('c-note').textContent=tw===100?'Weights total exactly 100%.':'Weights total '+r2(tw)+'% — scaled to 100% automatically.';
  $('c-work').textContent='grade = Σ(weight × score) ÷ Σ(weight)\n'+lines.join('\n')+'\n= '+r2(ts)+' ÷ '+r2(tw)+' = '+r2(avg)+'%';
  $('c-res').classList.add('show');
  save();
}
$('c-add').addEventListener('click',()=>{cRows.appendChild(cRow());save();});

/* ---------- GPA ---------- */
const POINTS={'A+':4.0,'A':4.0,'A-':3.7,'B+':3.3,'B':3.0,'B-':2.7,'C+':2.3,'C':2.0,'C-':1.7,'D+':1.3,'D':1.0,'D-':0.7,'F':0.0};
const gRows=$('g-rows'),gW=$('g-weighted');
function gRow(name,cr,gr,hon){
  const d=document.createElement('div');d.className='rowline';
  let opts='';for(const g of Object.keys(POINTS))opts+='<option'+(gr===g?' selected':'')+'>'+g+'</option>';
  d.innerHTML='<input type="text" placeholder="Course" aria-label="Course name" maxlength="40">'+
    '<input type="number" placeholder="Credits" aria-label="Credits" min="0" max="12" step="0.5" inputmode="decimal">'+
    '<select aria-label="Letter grade">'+opts+'</select>'+
    '<label class="gp-hon"><input type="checkbox" aria-label="Honors or AP">H/AP</label>'+
    '<button class="rm" type="button" aria-label="Remove course"><svg class="g-icon g-icon-sm" aria-hidden="true"><use href="#g-i-trash"/></svg></button>';
  const ins=d.querySelectorAll('input');
  if(name!==undefined)ins[0].value=name; if(cr!==undefined)ins[1].value=cr; if(hon)ins[2].checked=true;
  d.querySelectorAll('input,select').forEach(i=>i.addEventListener('input',calcGpa));
  d.querySelectorAll('input,select').forEach(i=>i.addEventListener('change',calcGpa));
  d.querySelector('.rm').addEventListener('click',()=>{d.remove();calcGpa();});
  return d;
}
function calcGpa(){
  showErr('g-err','');
  const rows=[...gRows.querySelectorAll('.rowline')];
  const weighted=gW.checked;
  let tc=0,tqp=0,lines=[],ok=false;
  for(const r of rows){
    const t=r.querySelector('input[type=text]').value.trim()||'Course';
    const cr=num(r.querySelector('input[type=number]').value);
    const gr=r.querySelector('select').value;
    const hon=r.querySelector('input[type=checkbox]').checked;
    if(isNaN(cr))continue;
    if(cr<=0||cr>12)return showErr('g-err','Credits must be between 0 and 12.'),$ ('g-res').classList.remove('show');
    const pts=POINTS[gr]+(weighted&&hon?1.0:0);
    ok=true;tc+=cr;tqp+=pts*cr;
    lines.push('  '+t+': '+gr+' → '+r2(POINTS[gr])+(weighted&&hon?' +1.0 (H/AP)':'')+' × '+cr+' cr = '+r2(pts*cr)+' pts');
  }
  if(!ok)return $('g-res').classList.remove('show');
  const gpa=tqp/tc;
  $('g-big').textContent='GPA '+r2(gpa);
  $('g-note').textContent=r2(tc)+' total credits · '+r2(tqp)+' quality points · '+(weighted?'weighted 4.0 scale (+1.0 Honors/AP)':'unweighted 4.0 scale');
  $('g-work').textContent='GPA = Σ(grade points × credits) ÷ Σ(credits)\n'+lines.join('\n')+'\n= '+r2(tqp)+' ÷ '+r2(tc)+' = '+r2(gpa);
  $('g-res').classList.add('show');
  save();
}
$('g-add').addEventListener('click',()=>{gRows.appendChild(gRow());save();});
gW.addEventListener('change',calcGpa);

/* ---------- persistence (strict validation) ---------- */
const LSKEY='gradeplan-v1';
function save(){
  try{
    const data={
      tab:tabBtns.find(b=>b.getAttribute('aria-selected')==='true').dataset.tab,
      f:[fCur.value,fGoal.value,fWt.value],
      c:[...cRows.querySelectorAll('.rowline')].map(r=>{const i=r.querySelectorAll('input');return[i[0].value,i[1].value,i[2].value];}),
      g:[...gRows.querySelectorAll('.rowline')].map(r=>[r.querySelector('input[type=text]').value,r.querySelector('input[type=number]').value,r.querySelector('select').value,r.querySelector('input[type=checkbox]').checked]),
      gw:gW.checked
    };
    localStorage.setItem(LSKEY,JSON.stringify(data));
  }catch(e){}
}
function validNumStr(v,min,max){if(typeof v!=='string')return false;const n=parseFloat(v);return v===''||(isFinite(n)&&n>=min&&n<=max);}
function load(){
  let d=null;
  try{d=JSON.parse(localStorage.getItem(LSKEY));}catch(e){return;}
  if(!d||typeof d!=='object')return;
  try{
    if(Array.isArray(d.f)&&d.f.length===3&&d.f.every(v=>validNumStr(v,0,100))){fCur.value=d.f[0];fGoal.value=d.f[1];fWt.value=d.f[2];}
    if(Array.isArray(d.c)){cRows.innerHTML='';for(const r of d.c.slice(0,30)){if(!Array.isArray(r)||r.length!==3)continue;const[n,w,s]=r;if(typeof n!=='string'||n.length>40||!validNumStr(w,0,100)||!validNumStr(s,0,100))continue;cRows.appendChild(cRow(n,w,s));}}
    if(Array.isArray(d.g)){gRows.innerHTML='';for(const r of d.g.slice(0,30)){if(!Array.isArray(r)||r.length!==4)continue;const[n,cr,gr,hon]=r;if(typeof n!=='string'||n.length>40||!POINTS.hasOwnProperty(gr)||typeof hon!=='boolean')continue;if(!validNumStr(cr,0,12))continue;gRows.appendChild(gRow(n,cr,gr,hon));}}
    if(typeof d.gw==='boolean')gW.checked=d.gw;
    if(typeof d.tab==='string'&&['final','course','gpa'].includes(d.tab))showTab(d.tab);
  }catch(e){}
}

/* ---------- init ---------- */
if(!cRows.children.length){cRows.appendChild(cRow('Homework',40,92));cRows.appendChild(cRow('Exams',60,78));}
if(!gRows.children.length){gRows.appendChild(gRow('Biology',3,'A',false));gRows.appendChild(gRow('Algebra II',4,'B+',false));}
load();
if(!cRows.children.length)cRows.appendChild(cRow());
if(!gRows.children.length)gRows.appendChild(gRow());
calcFinal();calcCourse();calcGpa();

</script>
