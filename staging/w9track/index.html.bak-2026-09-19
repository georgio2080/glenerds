<!DOCTYPE html>
<html lang="en" data-theme="auto">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>W9Track — Contractor W-9 &amp; 1099 Tracker</title>
<meta name="description" content="Offline tracker for contractor W-9 collection status and year-to-date payments. Flags who needs a 1099 at the $600 threshold.">
<style>
/* ---------- Theme tokens ---------- */
:root{
  --bg:#f6f7f9; --panel:#ffffff; --text:#1c2330; --muted:#5b6472;
  --border:#d9dee6; --accent:#1f6feb; --accent-text:#ffffff;
  --red:#c23333; --red-bg:#fdecec; --amber:#9a6200; --amber-bg:#fdf3dd;
  --green:#1d7a3a; --green-bg:#e9f6ec; --radius:10px; --tap:44px;
}
html[data-theme="dark"]{
  --bg:#12151b; --panel:#1b2029; --text:#e8ecf2; --muted:#9aa4b2;
  --border:#2e3642; --accent:#4d93ff; --accent-text:#0c1118;
  --red:#ff7b72; --red-bg:#3a1f1e; --amber:#e3a008; --amber-bg:#3a2f14;
  --green:#56d364; --green-bg:#1a3524;
}
@media (prefers-color-scheme: dark){
  html[data-theme="auto"]{
    --bg:#12151b; --panel:#1b2029; --text:#e8ecf2; --muted:#9aa4b2;
    --border:#2e3642; --accent:#4d93ff; --accent-text:#0c1118;
    --red:#ff7b72; --red-bg:#3a1f1e; --amber:#e3a008; --amber-bg:#3a2f14;
    --green:#56d364; --green-bg:#1a3524;
  }
}
/* ---------- Base ---------- */
*{box-sizing:border-box}
body{
  margin:0; background:var(--bg); color:var(--text);
  font-family:-apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,Helvetica,Arial,sans-serif;
  font-size:16px; line-height:1.5;
}
main{max-width:720px; margin:0 auto; padding:12px 12px 64px}
h1{font-size:1.4rem; margin:0}
h2{font-size:1.1rem; margin:1.5rem 0 .5rem}
p{margin:.4rem 0}
header.topbar{
  display:flex; align-items:center; justify-content:space-between; gap:8px;
  padding:10px 12px; background:var(--panel); border-bottom:1px solid var(--border);
  position:sticky; top:0; z-index:10;
}
.topbar .brand{font-weight:700}
.topbar .controls{display:flex; gap:8px; align-items:center}
.card{background:var(--panel); border:1px solid var(--border); border-radius:var(--radius); padding:12px; margin-bottom:12px}
button, input, select, textarea{font-size:1rem; font-family:inherit}
button{
  min-height:var(--tap); padding:8px 14px; border-radius:8px;
  border:1px solid var(--border); background:var(--panel); color:var(--text);
  cursor:pointer;
}
button.primary{background:var(--accent); color:var(--accent-text); border-color:transparent; font-weight:600}
button.danger{color:var(--red); border-color:var(--red)}
button.small{min-height:40px; padding:6px 10px; font-size:.9rem}
input, select, textarea{
  width:100%; min-height:var(--tap); padding:8px 10px; margin:2px 0 8px;
  border:1px solid var(--border); border-radius:8px; background:var(--panel); color:var(--text);
}
label{font-weight:600; display:block; margin-top:6px}
label .hint{font-weight:400; color:var(--muted); font-size:.85rem}
.row{display:flex; gap:8px; flex-wrap:wrap}
.row > *{flex:1 1 140px}
/* ---------- Dashboard ---------- */
.stats{display:grid; grid-template-columns:repeat(2,1fr); gap:8px}
.stat{background:var(--panel); border:1px solid var(--border); border-radius:var(--radius); padding:10px; text-align:center}
.stat .num{font-size:1.5rem; font-weight:700}
.stat .lbl{font-size:.85rem; color:var(--muted)}
.flag{border:1px solid var(--border); border-radius:var(--radius); padding:10px; margin-bottom:8px}
.flag.red{background:var(--red-bg); border-color:var(--red)}
.flag.amber{background:var(--amber-bg); border-color:var(--amber)}
.flag .fname{font-weight:700}
.flag .famt{font-weight:700}
.flag.red .fmsg{color:var(--red); font-weight:600}
.flag.amber .fmsg{color:var(--amber); font-weight:600}
.empty{color:var(--muted)}
/* ---------- Contractor cards ---------- */
.contractor{border:1px solid var(--border); border-radius:var(--radius); background:var(--panel); padding:12px; margin-bottom:10px}
.chead{display:flex; justify-content:space-between; gap:8px; align-items:flex-start; flex-wrap:wrap}
.cname{font-weight:700; font-size:1.05rem}
.cmeta{color:var(--muted); font-size:.9rem}
.pill{display:inline-block; padding:3px 10px; border-radius:999px; font-size:.82rem; font-weight:600; border:1px solid}
.pill.ok{color:var(--green); border-color:var(--green); background:var(--green-bg)}
.pill.missing{color:var(--amber); border-color:var(--amber); background:var(--amber-bg)}
.pill.bad{color:var(--red); border-color:var(--red); background:var(--red-bg)}
.cactions{display:flex; gap:6px; flex-wrap:wrap; margin-top:8px}
.exempt-note{color:var(--muted); font-size:.88rem; margin-top:6px}
.payments{margin-top:10px; border-top:1px dashed var(--border); padding-top:8px}
table{width:100%; border-collapse:collapse; margin:6px 0}
th, td{text-align:left; padding:8px 6px; border-bottom:1px solid var(--border); font-size:.95rem}
td.num, th.num{text-align:right; font-variant-numeric:tabular-nums}
form.inline{margin:0}
/* ---------- Explainer ---------- */
.explainer{font-size:.95rem}
.disclaimer{border-left:4px solid var(--amber); padding:6px 10px; background:var(--amber-bg); border-radius:0 8px 8px 0; margin-top:8px}
/* ---------- Footer ---------- */
footer.site{max-width:720px; margin:0 auto; padding:18px 12px 40px; color:var(--muted); font-size:.9rem; text-align:center}
footer.site a{color:var(--accent)}
/* ---------- Utility ---------- */
.hidden{display:none !important}
.status-msg{min-height:1.5em; margin:6px 0; font-weight:600}
.status-msg.error{color:var(--red)}
.status-msg.ok{color:var(--green)}
</style>
</head>
<body>
<header class="topbar">
  <div class="brand">W9Track</div>
  <div class="controls">
    <label for="yearSelect" class="hidden">Tax year</label>
    <select id="yearSelect" style="width:auto;min-height:44px;margin:0" aria-label="Tax year"></select>
    <button id="themeToggle" type="button" aria-label="Toggle dark mode">Dark</button>
  </div>
</header>
<main>
  <h1>W-9 &amp; 1099 Tracker</h1>
  <p class="cmeta">Track contractor W-9 collection and year-to-date payments. Everything stays on this device — W9Track never stores SSN or EIN numbers, only whether a W-9 is on file and the date received.</p>

  <!-- Dashboard -->
  <section aria-labelledby="dashHead">
    <h2 id="dashHead">Dashboard</h2>
    <div id="dashboard" aria-live="polite">
      <div class="stats" id="statGrid"></div>
      <h2>Needs attention</h2>
      <div id="flagList"></div>
    </div>
  </section>

  <!-- Explainer -->
  <section aria-labelledby="ruleHead" class="card explainer">
    <h2 id="ruleHead">The $600 rule</h2>
    <p>In general, if you pay a contractor <strong>$600 or more in a calendar year</strong> for services, you must file a Form 1099-NEC reporting those payments — and to file it you need their taxpayer information, collected with <strong>Form W-9</strong>.</p>
    <p><strong>How W9Track flags it:</strong> a contractor with no W-9 on file turns <strong>amber at $400</strong> in payments ("approaching the $600 threshold — collect the W-9 now") and <strong>red at $600</strong> ("needs 1099 — collect W-9 immediately"). Corporation contractors are generally exempt from 1099 reporting and are shown with an exempt note.</p>
    <div class="disclaimer" role="note"><strong>Not tax advice.</strong> Rules have exceptions and change. Confirm with your accountant or the IRS before filing anything.</div>
  </section>

  <!-- Add contractor -->
  <section aria-labelledby="addHead" class="card">
    <h2 id="addHead">Add contractor</h2>
    <form id="addContractorForm">
      <label for="ncName">Full name <span class="hint">(required)</span></label>
      <input id="ncName" name="name" type="text" maxlength="80" required autocomplete="off">
      <div class="row">
        <div>
          <label for="ncBiz">Business name <span class="hint">(optional)</span></label>
          <input id="ncBiz" type="text" maxlength="80" autocomplete="off">
        </div>
        <div>
          <label for="ncEntity">Entity type</label>
          <select id="ncEntity">
            <option value="individual">Individual</option>
            <option value="llc">LLC</option>
            <option value="corp">Corporation</option>
            <option value="other">Other</option>
          </select>
        </div>
      </div>
      <label for="ncContact">Contact <span class="hint">(optional — email or phone)</span></label>
      <input id="ncContact" type="text" maxlength="120" autocomplete="off">
      <label for="ncNotes">Notes <span class="hint">(optional — never enter SSN/EIN)</span></label>
      <textarea id="ncNotes" rows="2" maxlength="500"></textarea>
      <button type="submit" class="primary">Add contractor</button>
    </form>
  </section>

  <!-- Contractors -->
  <section aria-labelledby="clHead">
    <h2 id="clHead">Contractors</h2>
    <div id="contractorList"></div>
  </section>

  <!-- Data -->
  <section aria-labelledby="dataHead" class="card">
    <h2 id="dataHead">Data</h2>
    <div class="row">
      <button id="exportBtn" type="button">Export JSON</button>
      <button id="importBtn" type="button">Import JSON</button>
      <input id="importFile" type="file" accept="application/json,.json" class="hidden" aria-label="Choose JSON file to import">
    </div>
    <div class="row" style="margin-top:8px">
      <button id="demoBtn" type="button">Load demo data</button>
      <button id="clearBtn" type="button" class="danger">Clear all data</button>
    </div>
    <p id="dataMsg" class="status-msg" role="status"></p>
    <p class="cmeta">Import validates and sanitizes everything: text is length-capped, amounts must be finite numbers &ge; 0, dates must be valid YYYY-MM-DD, and years must be 2000&ndash;2099. Bad records are skipped and reported.</p>
  </section>

  <section aria-labelledby="yrHead" class="card">
    <h2 id="yrHead">Tax years</h2>
    <div class="row">
      <div>
        <label for="newYearInput">Add a year <span class="hint">(2000&ndash;2099)</span></label>
        <input id="newYearInput" type="text" inputmode="numeric" maxlength="4" placeholder="2028" aria-label="New tax year">
      </div>
      <div style="align-self:end"><button id="addYearBtn" type="button">Add year</button></div>
    </div>
  </section>
</main>
<footer class="site">
  <p>W9Track — your data never leaves this device. Not tax advice; confirm with your accountant.</p>
  <p>by <a href="https://glenerds.gumroad.com">Glenerds</a></p>
</footer>

<script>
"use strict";
/* ================= Storage ================= */
var STORE_KEY = "w9track_v1";
var THEME_KEY = "w9track_theme";
var RED_LIMIT = 600, AMBER_LIMIT = 400;
var DATE_RE = /^\d{4}-(0[1-9]|1[0-2])-(0[1-9]|[12]\d|3[01])$/;
var ENTITIES = ["individual","llc","corp","other"];
var MAX_CONTRACTORS = 1000, MAX_PAYMENTS = 5000;

function loadStore(){
  var store = { years:{}, settings:{} };
  try{
    var raw = localStorage.getItem(STORE_KEY);
    if(raw){
      var parsed = JSON.parse(raw);
      if(parsed && typeof parsed === "object" && parsed.years && typeof parsed.years === "object"){
        store.years = parsed.years;
      }
    }
  }catch(e){ /* corrupt -> start fresh */ }
  return store;
}
function saveStore(){ localStorage.setItem(STORE_KEY, JSON.stringify(store)); }
var store = loadStore();

function yearData(y){
  if(!store.years[y]) store.years[y] = { contractors: [] };
  return store.years[y];
}

/* ================= Helpers ================= */
function esc(s){ return String(s == null ? "" : s); }
function el(tag, text, cls){
  var n = document.createElement(tag);
  if(cls) n.className = cls;
  if(text != null) n.textContent = text;
  return n;
}
function money(n){ return "$" + Number(n).toFixed(2); }
function todayISO(){
  var d = new Date();
  return d.getFullYear() + "-" + String(d.getMonth()+1).padStart(2,"0") + "-" + String(d.getDate()).padStart(2,"0");
}
function validDate(s){ return DATE_RE.test(s); }
function ytd(c){ return c.payments.reduce(function(t,p){ return t + p.amount; }, 0); }
function uid(){ return "c" + Date.now().toString(36) + Math.floor(Math.random()*1e6).toString(36); }

/* ================= Sanitization (shared by import) ================= */
function capText(v, max){
  if(typeof v !== "string") return "";
  v = v.trim();
  return v.length > max ? v.slice(0, max) : v;
}
function sanitizePayment(p){
  if(!p || typeof p !== "object") return null;
  if(typeof p.date !== "string" || !validDate(p.date)) return null;
  var amt = Number(p.amount);
  if(!isFinite(amt) || amt < 0) return null;
  amt = Math.round(amt * 100) / 100;
  return { date: p.date, amount: amt, memo: capText(p.memo, 120) };
}
function sanitizeContractor(c){
  if(!c || typeof c !== "object") return null;
  var name = capText(c.name, 80);
  if(!name) return null;
  var entity = ENTITIES.indexOf(c.entity) >= 0 ? c.entity : "individual";
  var w9 = c.w9 === true;
  var w9Date = (typeof c.w9Date === "string" && validDate(c.w9Date)) ? c.w9Date : "";
  if(!w9) w9Date = "";
  var payments = [];
  if(Array.isArray(c.payments)){
    for(var i=0; i<c.payments.length && payments.length<MAX_PAYMENTS; i++){
      var sp = sanitizePayment(c.payments[i]);
      if(sp) payments.push(sp);
    }
  }
  return {
    id: (typeof c.id === "string" && /^[A-Za-z0-9_-]{1,32}$/.test(c.id)) ? c.id : uid(),
    name: name,
    business: capText(c.business, 80),
    contact: capText(c.contact, 120),
    entity: entity,
    w9: w9,
    w9Date: w9Date,
    notes: capText(c.notes, 500),
    payments: payments
  };
}
function validYear(y){ return /^(20\d{2})$/.test(y) && Number(y) >= 2000 && Number(y) <= 2099; }

/* ================= State ================= */
var years = Object.keys(store.years).filter(validYear).sort();
["2025","2026","2027"].forEach(function(y){ if(years.indexOf(y)<0) years.push(y); });
years.sort();
var currentYear = String(new Date().getFullYear());
if(!validYear(currentYear)) currentYear = "2026";
if(years.indexOf(currentYear)<0){ years.push(currentYear); years.sort(); }

/* ================= Theme ================= */
var themeToggle = document.getElementById("themeToggle");
function currentTheme(){
  var t = localStorage.getItem(THEME_KEY);
  if(t === "dark" || t === "light") return t;
  return "auto";
}
function applyTheme(){
  var t = currentTheme();
  document.documentElement.setAttribute("data-theme", t);
  var dark = (t === "dark") || (t === "auto" && window.matchMedia("(prefers-color-scheme: dark)").matches);
  themeToggle.textContent = dark ? "Light" : "Dark";
  themeToggle.setAttribute("aria-pressed", dark ? "true" : "false");
}
themeToggle.addEventListener("click", function(){
  var now = document.documentElement.getAttribute("data-theme");
  var dark = (now === "dark") || (now === "auto" && window.matchMedia("(prefers-color-scheme: dark)").matches);
  localStorage.setItem(THEME_KEY, dark ? "light" : "dark");
  applyTheme();
});
if(window.matchMedia){
  window.matchMedia("(prefers-color-scheme: dark)").addEventListener("change", applyTheme);
}
applyTheme();

/* ================= Year selector ================= */
var yearSelect = document.getElementById("yearSelect");
function renderYearSelect(){
  while(yearSelect.firstChild) yearSelect.removeChild(yearSelect.firstChild);
  years.forEach(function(y){
    var opt = document.createElement("option");
    opt.value = y; opt.textContent = y;
    if(y === currentYear) opt.selected = true;
    yearSelect.appendChild(opt);
  });
}
yearSelect.addEventListener("change", function(){ currentYear = yearSelect.value; renderAll(); });
document.getElementById("addYearBtn").addEventListener("click", function(){
  var inp = document.getElementById("newYearInput");
  var y = inp.value.trim();
  if(!validYear(y)){ setDataMsg("Enter a 4-digit year between 2000 and 2099.", true); return; }
  if(years.indexOf(y)<0){ years.push(y); years.sort(); }
  currentYear = y; inp.value = "";
  renderYearSelect(); renderAll();
  setDataMsg("Switched to tax year " + y + ".", false);
});

/* ================= Dashboard ================= */
function renderDashboard(){
  var contractors = yearData(currentYear).contractors;
  var onFile = contractors.filter(function(c){ return c.w9; }).length;
  var total = contractors.reduce(function(t,c){ return t + ytd(c); }, 0);

  var statGrid = document.getElementById("statGrid");
  while(statGrid.firstChild) statGrid.removeChild(statGrid.firstChild);
  var stats = [
    ["Contractors", String(contractors.length)],
    ["W-9s on file", String(onFile)],
    ["W-9s missing", String(contractors.length - onFile)],
    ["Total paid YTD", money(total)]
  ];
  stats.forEach(function(s){
    var d = el("div", null, "stat");
    d.appendChild(el("div", s[1], "num"));
    d.appendChild(el("div", s[0], "lbl"));
    statGrid.appendChild(d);
  });

  var flagList = document.getElementById("flagList");
  while(flagList.firstChild) flagList.removeChild(flagList.firstChild);
  var flagged = contractors.filter(function(c){
    return !c.w9 && c.entity !== "corp" && ytd(c) >= AMBER_LIMIT;
  }).sort(function(a,b){ return ytd(b) - ytd(a); });

  if(!flagged.length){
    flagList.appendChild(el("p", "No contractors near the $600 threshold without a W-9.", "empty"));
    return;
  }
  flagged.forEach(function(c){
    var t = ytd(c);
    var red = t >= RED_LIMIT;
    var f = el("div", null, "flag " + (red ? "red" : "amber"));
    var top = el("div");
    top.appendChild(el("span", c.name, "fname"));
    top.appendChild(document.createTextNode(" — "));
    top.appendChild(el("span", money(t) + " YTD", "famt"));
    f.appendChild(top);
    f.appendChild(el("div", red ? "Needs 1099 + collect W-9" : "Approaching $600 threshold — collect W-9", "fmsg"));
    flagList.appendChild(f);
  });
}

/* ================= Contractor list ================= */
var openPanels = {}; // contractor id -> true

function w9Pill(c){
  var cls, txt;
  if(c.w9){ cls = "pill ok"; txt = "W-9 on file" + (c.w9Date ? " · " + c.w9Date : ""); }
  else { cls = "pill missing"; txt = "W-9 missing"; }
  return el("span", txt, cls);
}

function flagPill(c){
  var t = ytd(c);
  if(c.w9 || t < AMBER_LIMIT || c.entity === "corp") return null;
  return el("span", t >= RED_LIMIT ? "Needs 1099" : "Near $600", "pill " + (t >= RED_LIMIT ? "bad" : "missing"));
}

function renderContractors(){
  var list = document.getElementById("contractorList");
  while(list.firstChild) list.removeChild(list.firstChild);
  var contractors = yearData(currentYear).contractors;
  if(!contractors.length){
    list.appendChild(el("p", "No contractors yet for " + currentYear + ". Add one above or load demo data.", "empty"));
    return;
  }
  contractors.forEach(function(c){
    var card = el("div", null, "contractor");
    var head = el("div", null, "chead");
    var left = el("div");
    left.appendChild(el("div", c.name, "cname"));
    var metaBits = [];
    if(c.business) metaBits.push(c.business);
    metaBits.push({individual:"Individual", llc:"LLC", corp:"Corporation", other:"Other"}[c.entity]);
    metaBits.push(money(ytd(c)) + " YTD");
    left.appendChild(el("div", metaBits.join(" · "), "cmeta"));
    head.appendChild(left);
    var pills = el("div");
    pills.appendChild(w9Pill(c));
    var fp = flagPill(c);
    if(fp){ pills.appendChild(document.createTextNode(" ")); pills.appendChild(fp); }
    head.appendChild(pills);
    card.appendChild(head);
    if(c.contact) card.appendChild(el("div", "Contact: " + c.contact, "cmeta"));
    if(c.notes) card.appendChild(el("div", c.notes, "cmeta"));
    if(c.entity === "corp") card.appendChild(el("div", "Corporations are generally exempt from 1099 reporting.", "exempt-note"));

    var actions = el("div", null, "cactions");
    var w9Btn = el("button", c.w9 ? "Clear W-9" : "Mark W-9 received", "small");
    w9Btn.type = "button";
    w9Btn.setAttribute("aria-label", (c.w9 ? "Clear W-9 for " : "Mark W-9 received for ") + c.name);
    w9Btn.addEventListener("click", function(){
      c.w9 = !c.w9;
      c.w9Date = c.w9 ? todayISO() : "";
      saveStore(); renderAll();
    });
    var payBtn = el("button", openPanels[c.id] ? "Hide payments" : "Payments", "small");
    payBtn.type = "button";
    payBtn.setAttribute("aria-expanded", openPanels[c.id] ? "true" : "false");
    payBtn.addEventListener("click", function(){
      openPanels[c.id] = !openPanels[c.id];
      renderAll();
    });
    var editBtn = el("button", "Edit", "small");
    editBtn.type = "button";
    editBtn.addEventListener("click", function(){ openEdit(card, c); });
    var delBtn = el("button", "Delete", "small danger");
    delBtn.type = "button";
    delBtn.addEventListener("click", function(){
      if(window.confirm("Delete " + c.name + " and all their payments?")){
        var arr = yearData(currentYear).contractors;
        arr.splice(arr.indexOf(c), 1);
        delete openPanels[c.id];
        saveStore(); renderAll();
      }
    });
    actions.appendChild(w9Btn); actions.appendChild(payBtn);
    actions.appendChild(editBtn); actions.appendChild(delBtn);
    card.appendChild(actions);

    if(openPanels[c.id]) card.appendChild(paymentsPanel(c));
    list.appendChild(card);
  });
}

/* Edit form (built with DOM APIs, values via .value) */
function openEdit(card, c){
  var old = card.querySelector(".editform");
  if(old){ old.remove(); return; }
  var form = el("form", null, "editform payments");
  var fields = [
    ["eName", "Full name", "text", c.name, 80],
    ["eBiz", "Business name", "text", c.business, 80],
    ["eContact", "Contact", "text", c.contact, 120]
  ];
  fields.forEach(function(f){
    var lab = document.createElement("label");
    lab.setAttribute("for", f[0] + c.id); lab.textContent = f[1];
    var inp = document.createElement("input");
    inp.id = f[0] + c.id; inp.type = f[2]; inp.maxLength = f[4];
    inp.value = f[3];
    form.appendChild(lab); form.appendChild(inp);
  });
  var eLab = document.createElement("label");
  eLab.setAttribute("for", "eEnt" + c.id); eLab.textContent = "Entity type";
  var eSel = document.createElement("select"); eSel.id = "eEnt" + c.id;
  ENTITIES.forEach(function(e){
    var o = document.createElement("option");
    o.value = e; o.textContent = e.charAt(0).toUpperCase() + e.slice(1);
    if(e === c.entity) o.selected = true;
    eSel.appendChild(o);
  });
  form.appendChild(eLab); form.appendChild(eSel);
  var wLab = document.createElement("label");
  wLab.setAttribute("for", "eW9" + c.id); wLab.textContent = "W-9 on file";
  var wSel = document.createElement("select"); wSel.id = "eW9" + c.id;
  [["", "No"], ["1", "Yes"]].forEach(function(o){
    var op = document.createElement("option");
    op.value = o[0]; op.textContent = o[1];
    if((o[0] === "1") === c.w9) op.selected = true;
    wSel.appendChild(op);
  });
  form.appendChild(wLab); form.appendChild(wSel);
  var dLab = document.createElement("label");
  dLab.setAttribute("for", "eW9d" + c.id); dLab.textContent = "W-9 date received";
  var dInp = document.createElement("input");
  dInp.id = "eW9d" + c.id; dInp.type = "date"; dInp.value = c.w9Date || "";
  form.appendChild(dLab); form.appendChild(dInp);
  var nLab = document.createElement("label");
  nLab.setAttribute("for", "eNotes" + c.id); nLab.textContent = "Notes";
  var nTa = document.createElement("textarea");
  nTa.id = "eNotes" + c.id; nTa.rows = 2; nTa.maxLength = 500; nTa.value = c.notes;
  form.appendChild(nLab); form.appendChild(nTa);
  var btnRow = el("div", null, "cactions");
  var save = el("button", "Save", "primary"); save.type = "submit";
  var cancel = el("button", "Cancel"); cancel.type = "button";
  cancel.addEventListener("click", function(){ form.remove(); });
  btnRow.appendChild(save); btnRow.appendChild(cancel);
  form.appendChild(btnRow);
  form.addEventListener("submit", function(ev){
    ev.preventDefault();
    var name = form.querySelector("#eName" + c.id).value.trim();
    if(!name){ window.alert("Name is required."); return; }
    c.name = name.slice(0,80);
    c.business = form.querySelector("#eBiz" + c.id).value.trim().slice(0,80);
    c.contact = form.querySelector("#eContact" + c.id).value.trim().slice(0,120);
    c.entity = eSel.value;
    c.w9 = (wSel.value === "1");
    var dval = dInp.value;
    c.w9Date = (c.w9 && validDate(dval)) ? dval : (c.w9 ? todayISO() : "");
    c.notes = nTa.value.trim().slice(0,500);
    saveStore(); renderAll();
  });
  card.appendChild(form);
}

/* Payments panel */
function paymentsPanel(c){
  var wrap = el("div", null, "payments");
  wrap.appendChild(el("strong", "Payments — " + money(ytd(c)) + " YTD"));
  if(c.payments.length){
    var table = document.createElement("table");
    var thead = document.createElement("thead");
    var tr = document.createElement("tr");
    ["Date","Memo","Amount",""].forEach(function(h, i){
      var th = document.createElement("th");
      th.setAttribute("scope", "col"); th.textContent = h;
      if(i === 2) th.className = "num";
      tr.appendChild(th);
    });
    thead.appendChild(tr); table.appendChild(thead);
    var tbody = document.createElement("tbody");
    c.payments.slice().sort(function(a,b){ return a.date < b.date ? -1 : 1; }).forEach(function(p){
      var r = document.createElement("tr");
      var tdD = document.createElement("td"); tdD.textContent = p.date; r.appendChild(tdD);
      var tdM = document.createElement("td"); tdM.textContent = p.memo || "—"; r.appendChild(tdM);
      var tdA = document.createElement("td"); tdA.className = "num"; tdA.textContent = money(p.amount); r.appendChild(tdA);
      var tdX = document.createElement("td");
      var del = el("button", "Delete", "small danger"); del.type = "button";
      del.setAttribute("aria-label", "Delete payment of " + money(p.amount) + " on " + p.date);
      del.addEventListener("click", function(){
        if(window.confirm("Delete this payment?")){
          c.payments.splice(c.payments.indexOf(p), 1);
          saveStore(); renderAll();
        }
      });
      tdX.appendChild(del); r.appendChild(tdX);
      tbody.appendChild(r);
    });
    table.appendChild(tbody); wrap.appendChild(table);
  } else {
    wrap.appendChild(el("p", "No payments recorded yet.", "empty"));
  }
  var form = el("form", null, "inline");
  form.setAttribute("aria-label", "Add payment for " + c.name);
  var row = el("div", null, "row");
  var dWrap = el("div");
  var dLab = document.createElement("label"); dLab.textContent = "Date";
  dLab.setAttribute("for", "pDate" + c.id);
  var dInp = document.createElement("input");
  dInp.id = "pDate" + c.id; dInp.type = "date"; dInp.required = true; dInp.value = todayISO();
  dWrap.appendChild(dLab); dWrap.appendChild(dInp);
  var aWrap = el("div");
  var aLab = document.createElement("label"); aLab.textContent = "Amount";
  aLab.setAttribute("for", "pAmt" + c.id);
  var aInp = document.createElement("input");
  aInp.id = "pAmt" + c.id; aInp.type = "number"; aInp.min = "0"; aInp.step = "0.01";
  aInp.required = true; aInp.placeholder = "0.00";
  aWrap.appendChild(aLab); aWrap.appendChild(aInp);
  var mWrap = el("div");
  var mLab = document.createElement("label"); mLab.textContent = "Memo (optional)";
  mLab.setAttribute("for", "pMemo" + c.id);
  var mInp = document.createElement("input");
  mInp.id = "pMemo" + c.id; mInp.type = "text"; mInp.maxLength = 120;
  mWrap.appendChild(mLab); mWrap.appendChild(mInp);
  row.appendChild(dWrap); row.appendChild(aWrap); row.appendChild(mWrap);
  form.appendChild(row);
  var add = el("button", "Add payment", "primary"); add.type = "submit";
  form.appendChild(add);
  form.addEventListener("submit", function(ev){
    ev.preventDefault();
    if(!validDate(dInp.value)){ window.alert("Enter a valid date."); return; }
    var amt = Number(aInp.value);
    if(!isFinite(amt) || amt < 0){ window.alert("Enter a valid amount of 0 or more."); return; }
    c.payments.push({
      date: dInp.value,
      amount: Math.round(amt * 100) / 100,
      memo: mInp.value.trim().slice(0,120)
    });
    saveStore(); renderAll();
  });
  wrap.appendChild(form);
  return wrap;
}

