<!DOCTYPE html>
<html lang="en" data-theme="light">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<meta name="robots" content="noindex, nofollow">
<meta name="description" content="MoveInProof — document your apartment's move-in condition room by room with photos, and print a timestamped handover report. Single-file offline tool.">
<title>MoveInProof — Move-In Damage Logger</title>
<script>
/* Early theme set (prevents flash); mirrors the stored preference logic below. */
(function(){try{var t=localStorage.getItem("moveinproof.theme.v1");if(!t){t=(window.matchMedia&&window.matchMedia("(prefers-color-scheme: dark)").matches)?"dark":"light";}document.documentElement.setAttribute("data-theme",t);}catch(e){}})();
</script>
<style>
  :root {
    color-scheme: light;
    --bg: #f6f5f2;
    --surface: #ffffff;
    --surface-2: #efede8;
    --text: #1d1c1a;
    --muted: #68645b;
    --border: #dcd8cd;
    --accent: #0b5cad;
    --accent-strong: #084a8c;
    --on-accent: #ffffff;
    --good: #146c38;
    --warn: #8a5200;
    --bad: #b3261e;
    --chip: #e9f1f9;
    --radius: 10px;
    --shadow: 0 1px 2px rgba(0,0,0,.06);
  }
  [data-theme="dark"] {
    color-scheme: dark;
    --bg: #141311;
    --surface: #1e1c19;
    --surface-2: #262420;
    --text: #ece9e1;
    --muted: #a9a49a;
    --border: #3a372f;
    --accent: #8bbdf2;
    --accent-strong: #a8cdf5;
    --on-accent: #0c1a28;
    --good: #82dda6;
    --warn: #e8b84b;
    --bad: #f0968d;
    --chip: #222b35;
    --shadow: 0 1px 2px rgba(0,0,0,.35);
  }
  * { box-sizing: border-box; }
  html, body { overflow-x: clip; }
  body {
    margin: 0;
    font-family: system-ui, -apple-system, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
    background: var(--bg);
    color: var(--text);
    line-height: 1.5;
  }
  a { color: var(--accent); }
  header.top {
    display: flex; align-items: center; justify-content: space-between; gap: 1rem;
    padding: 1.25rem 1.5rem; background: var(--surface);
    border-bottom: 1px solid var(--border); flex-wrap: wrap;
  }
  header.top h1 { margin: 0; font-size: 1.5rem; letter-spacing: -0.01em; }
  header.top p { margin: .15rem 0 0; color: var(--muted); font-size: .92rem; }
  main { max-width: 46rem; margin: 0 auto; padding: 1rem; display: grid; gap: 1rem; }
  section.card {
    background: var(--surface); border: 1px solid var(--border); border-radius: var(--radius);
    box-shadow: var(--shadow); padding: 1.25rem;
  }
  section.card h2 { margin: 0 0 .75rem; font-size: 1.15rem; }
  .field { margin-bottom: .8rem; }
  label.flabel { display: block; font-weight: 600; font-size: .92rem; margin-bottom: .3rem; }
  input[type="text"], input[type="date"], textarea, select {
    width: 100%; min-height: 44px; padding: .6rem .7rem; font: inherit; color: var(--text);
    background: var(--surface); border: 1px solid var(--border); border-radius: 8px;
  }
  textarea { min-height: 88px; resize: vertical; }
  input:focus-visible, textarea:focus-visible, select:focus-visible, button:focus-visible, .filebtn:focus-within {
    outline: 3px solid var(--accent); outline-offset: 2px;
  }
  .btn {
    display: inline-flex; align-items: center; justify-content: center; gap: .4rem;
    min-height: 44px; padding: .65rem 1.1rem; border-radius: 8px; font: inherit; font-weight: 600;
    cursor: pointer; border: 1px solid transparent; text-decoration: none;
  }
  .btn-primary { background: var(--accent); color: var(--on-accent); }
  .btn-primary:hover { background: var(--accent-strong); }
  .btn-secondary { background: var(--surface-2); color: var(--text); border-color: var(--border); }
  .btn-danger { background: transparent; color: var(--bad); border-color: var(--bad); }
  .btn-row { display: flex; flex-wrap: wrap; gap: .6rem; margin: .5rem 0; }
  .filebtn {
    display: inline-flex; align-items: center; justify-content: center;
    min-height: 44px; padding: .6rem 1rem; border-radius: 8px; font: inherit; font-weight: 600;
    background: var(--surface-2); color: var(--text); border: 1px dashed var(--border); cursor: pointer;
  }
  .visually-hidden {
    position: absolute !important; width: 1px; height: 1px; margin: -1px; padding: 0;
    overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; border: 0;
  }
  .room-card { border: 1px solid var(--border); border-radius: var(--radius); padding: 1rem; margin-bottom: 1rem; background: var(--surface); }
  .room-head { display: flex; gap: .6rem; align-items: center; margin-bottom: .8rem; flex-wrap: wrap; }
  .room-head input.room-name { flex: 1 1 12rem; font-size: 1.05rem; font-weight: 700; }
  fieldset.rating { border: 1px solid var(--border); border-radius: 8px; padding: .6rem .8rem; margin: 0 0 .8rem; }
  fieldset.rating legend { font-weight: 600; font-size: .92rem; padding: 0 .4rem; }
  .rating-opts { display: flex; flex-wrap: wrap; gap: .4rem; }
  .rating-opts label {
    display: inline-flex; align-items: center; gap: .4rem; min-height: 44px; padding: .4rem .8rem;
    border: 1px solid var(--border); border-radius: 999px; cursor: pointer; font-size: .92rem;
  }
  .rating-opts input { width: 1.1rem; height: 1.1rem; accent-color: var(--accent); margin: 0; }
  .defect { border: 1px solid var(--border); border-left: 4px solid var(--warn); border-radius: 8px; padding: .8rem; margin: .7rem 0; background: var(--surface); }
  .defect-head { display: flex; flex-wrap: wrap; gap: .5rem; align-items: center; margin-bottom: .4rem; }
  .defect-head strong { font-size: 1.02rem; }
  .chip { display: inline-block; font-size: .78rem; font-weight: 700; text-transform: capitalize;
    padding: .15rem .6rem; border-radius: 999px; background: var(--chip); color: var(--text); }
  .chip.sev-minor { background: var(--chip); color: var(--good); }
  .chip.sev-moderate { background: var(--chip); color: var(--warn); }
  .chip.sev-major { background: var(--chip); color: var(--bad); }
  .defect-meta { color: var(--muted); font-size: .85rem; margin: .3rem 0; }
  .defect p.desc { margin: .4rem 0; white-space: pre-wrap; }
  .defect-actions { display: flex; flex-wrap: wrap; gap: .5rem; margin-top: .6rem; }
  .btn-sm { min-height: 40px; padding: .45rem .8rem; font-size: .9rem; }
  .add-defect { border: 1px dashed var(--border); border-radius: 8px; padding: .8rem; margin-top: .8rem; background: var(--surface-2); }
  .add-defect h4 { margin: 0 0 .6rem; font-size: .95rem; }
  .form-grid { display: grid; gap: .6rem; grid-template-columns: 1fr; }
  @media (min-width: 560px) { .form-grid.two { grid-template-columns: 1fr 1fr; } }
  .ph-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(96px, 1fr)); gap: .5rem; margin: .6rem 0; }
  figure.ph-thumb { margin: 0; position: relative; }
  figure.ph-thumb img { width: 100%; aspect-ratio: 1; object-fit: cover; border-radius: 8px; border: 1px solid var(--border); display: block; }
  .ph-del {
    position: absolute; top: 4px; right: 4px; min-height: 40px; min-width: 40px; border-radius: 8px;
    background: rgba(0,0,0,.65); color: #fff; border: 1px solid rgba(255,255,255,.4); font-size: .8rem; cursor: pointer; padding: .3rem .5rem;
  }
  .sec-label { font-weight: 600; font-size: .9rem; margin: .8rem 0 .2rem; color: var(--muted); }
  #msg { min-height: 1.5em; margin-top: .6rem; font-size: .92rem; color: var(--muted); }
  #msg.alert { color: var(--bad); font-weight: 600; }
  /* Report */
  #report .rep-block { margin-bottom: 1.2rem; }
  #report dl.rep-head { display: grid; grid-template-columns: auto 1fr; gap: .25rem .8rem; margin: 0; }
  #report dl.rep-head dt { font-weight: 700; color: var(--muted); font-size: .9rem; }
  #report dl.rep-head dd { margin: 0; }
  .rep-room { border: 1px solid var(--border); border-radius: 8px; padding: .8rem; margin: .8rem 0; break-inside: avoid; page-break-inside: avoid; }
  .rep-room h3 { margin: 0 0 .3rem; }
  .rep-defect { margin: .6rem 0; padding-top: .6rem; border-top: 1px solid var(--border); }
  .rep-thumbs { display: flex; flex-wrap: wrap; gap: .4rem; margin-top: .4rem; }
  .rep-thumbs img { width: 120px; height: 120px; object-fit: cover; border: 1px solid var(--border); border-radius: 6px; }
  .sig-grid { display: grid; gap: 1rem; grid-template-columns: 1fr; margin-top: 1.5rem; }
  @media (min-width: 560px) { .sig-grid { grid-template-columns: 1fr 1fr; } }
  .sig-box { border: 1px solid var(--border); border-radius: 8px; padding: .8rem; }
  .sig-line { border-bottom: 1px solid var(--text); min-height: 2.2rem; margin: .6rem 0 .2rem; }
  .sig-cap { font-size: .8rem; color: var(--muted); }
  footer.site { text-align: center; color: var(--muted); font-size: .85rem; padding: 1.5rem 1rem 2rem; }
  @media print {
    html[data-theme="dark"] {
      --bg: #ffffff; --surface: #ffffff; --surface-2: #f2f2f2; --text: #111111;
      --muted: #444444; --border: #999999; --accent: #000000; --on-accent: #ffffff;
      --good: #0a5a2a; --warn: #6a3d00; --bad: #8f1d16; --chip: #eeeeee;
    }
    header.top, #propSection, #roomsSection, #actionsSection, footer.site { display: none !important; }
    main { max-width: none; padding: 0; display: block; }
    section.card { border: none; box-shadow: none; padding: 0; }
    body { background: #fff; }
    .rep-thumbs img { width: 110px; height: 110px; }
  }
</style>
</head>
<body>
<header class="top">
  <div>
    <h1>MoveInProof</h1>
    <p>Document your move-in condition, room by room — with photos, before you unpack.</p>
  </div>
  <button type="button" class="btn btn-secondary" id="themeToggle" aria-pressed="false">Dark mode: off</button>
</header>

<main>
  <section class="card" id="propSection" aria-labelledby="propH">
    <h2 id="propH">Property</h2>
    <div class="field">
      <label class="flabel" for="f-address">Property address</label>
