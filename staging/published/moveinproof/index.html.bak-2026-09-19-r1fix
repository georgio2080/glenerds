        <label class="flabel" for="f-tenants">Tenant name(s)</label>
        <input type="text" id="f-tenants" autocomplete="off">
      </div>
      <div class="field">
        <label class="flabel" for="f-lease">Lease start date</label>
        <input type="date" id="f-lease">
      </div>
      <div class="field">
        <label class="flabel" for="f-movein">Move-in date</label>
        <input type="date" id="f-movein">
      </div>
    </div>
  </section>

  <section class="card" id="roomsSection" aria-labelledby="roomsH">
    <h2 id="roomsH">Rooms</h2>
