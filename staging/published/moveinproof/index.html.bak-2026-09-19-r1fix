    <div id="report"></div>
  </section>
</main>

<footer class="site">
  <a href="https://glenerds.gumroad.com">by Glenerds</a> &nbsp;·&nbsp; Single-file offline app — your data never leaves this browser.
</footer>

<script>
"use strict";
/* ============================================================
   MoveInProof — move-in damage logger. Single-file offline app.
   Security: user/imported strings are rendered ONLY via
   textContent and DOM APIs. Photos are rendered ONLY via
   img.src assignment, allowlisted to data:image/jpeg and
   data:image/png. No innerHTML anywhere in this file.
   ============================================================ */

var LS_KEY = "moveinproof.state.v1";
var LS_THEME = "moveinproof.theme.v1";
var RATINGS = ["Excellent", "Good", "Fair", "Poor"];
var TYPES = ["scuff", "stain", "crack", "dent", "missing", "broken", "dirty", "other"];
var SEVS = ["minor", "moderate", "major"];
var MAX_STR = 2000;

/* ---------- tiny DOM helpers ---------- */
function h(tag, cls, text) {
  var e = document.createElement(tag);
  if (cls) e.className = cls;
  if (text !== undefined && text !== null) e.textContent = text;
  return e;
}
function uid() {
  return "x" + Date.now().toString(36) + Math.random().toString(36).slice(2, 8);
}
function todayStr() {
  var d = new Date();
  return d.getFullYear() + "-" + String(d.getMonth() + 1).padStart(2, "0") + "-" + String(d.getDate()).padStart(2, "0");
}
function fmtTs(iso) {
  try { return new Date(iso).toLocaleString(); } catch (e) { return String(iso || ""); }
}
function esc2cap(s) { return s.charAt(0).toUpperCase() + s.slice(1); }

/* ---------- sanitizers (import path + storage) ---------- */
function cap(v, max) {
  if (v === null || v === undefined) return "";
  return String(v).slice(0, max || MAX_STR);
}
function enumPick(v, allowed, dflt) {
  return allowed.indexOf(v) !== -1 ? v : dflt;
}
function isPhotoURL(v) {
  return typeof v === "string" &&
    (v.indexOf("data:image/jpeg") === 0 || v.indexOf("data:image/png") === 0);
}
function sanPhotos(a) {
  var out = [];
  if (!Array.isArray(a)) return out;
  for (var i = 0; i < a.length && out.length < 60; i++) {
    if (isPhotoURL(a[i])) out.push(String(a[i]).slice(0, 6 * 1024 * 1024));
  }
  return out;
}
function sanitizeState(o) {
  o = (o && typeof o === "object") ? o : {};
  var hd = (o.header && typeof o.header === "object") ? o.header : {};
  var st = {
    header: {
      address: cap(hd.address, 300),
      landlord: cap(hd.landlord, 160),
      leaseStart: cap(hd.leaseStart, 20),
      moveIn: cap(hd.moveIn, 20),
      tenants: cap(hd.tenants, 240)
    },
    rooms: []
  };
  var rooms = Array.isArray(o.rooms) ? o.rooms : [];
  for (var i = 0; i < rooms.length && st.rooms.length < 60; i++) {
    var r = rooms[i];
    if (!r || typeof r !== "object") continue;
    var room = {
      id: cap(r.id, 40) || uid(),
      name: cap(r.name, 80) || "Room",
      rating: enumPick(r.rating, RATINGS, ""),
      notes: cap(r.notes, 3000),
      photos: sanPhotos(r.photos),
      defects: []
    };
    var defs = Array.isArray(r.defects) ? r.defects : [];
    for (var j = 0; j < defs.length && room.defects.length < 200; j++) {
      var d = defs[j];
      if (!d || typeof d !== "object") continue;
      room.defects.push({
        id: cap(d.id, 40) || uid(),
        item: cap(d.item, 120),
        type: enumPick(d.type, TYPES, "other"),
        severity: enumPick(d.severity, SEVS, "minor"),
        desc: cap(d.desc, 3000),
        ts: cap(d.ts, 40),
        photos: sanPhotos(d.photos)
      });
    }
    st.rooms.push(room);
  }
  return st;
}

/* ---------- state ---------- */
function blankState() {
  return { header: { address: "", landlord: "", leaseStart: "", moveIn: todayStr(), tenants: "" }, rooms: [] };
}
function seedRooms() {
  return ["Living Room", "Kitchen", "Bedroom", "Bathroom", "Hallway", "Exterior/Balcony"].map(function (n) {
    return { id: uid(), name: n, rating: "", notes: "", photos: [], defects: [] };
  });
}
function loadState() {
  try {
    var raw = localStorage.getItem(LS_KEY);
    if (raw) return sanitizeState(JSON.parse(raw));
  } catch (e) { /* corrupt or unavailable: start fresh */ }
  var st = blankState();
  st.rooms = seedRooms();
  return st;
}
var state = loadState();
var editingDefectId = null;

function saveState() {
  try {
    localStorage.setItem(LS_KEY, JSON.stringify(state));
    return true;
  } catch (e) {
    var largest = findLargestPhoto();
    say("Storage is full — the last change was not saved. " +
      (largest ? ("The largest photo (" + largest.kb + " KB) is attached to " + largest.where +
        ". Delete it or other photos to free space.") :
        "Delete some photos to free space."), true);
    return false;
  }
}
function findLargestPhoto() {
  var best = null;
  function consider(url, where) {
    var bytes = Math.round(String(url).length * 3 / 4);
    if (!best || bytes > best.bytes) best = { bytes: bytes, kb: Math.round(bytes / 1024), where: where };
  }
  state.rooms.forEach(function (r) {
    r.photos.forEach(function (u) { consider(u, "the room '" + r.name + "'"); });
    r.defects.forEach(function (d) {
      d.photos.forEach(function (u) { consider(u, "the defect '" + (d.item || "untitled") + "' in '" + r.name + "'"); });
    });
  });
  return best;
}

/* ---------- messaging ---------- */
var msgEl = null;
function say(text, isAlert) {
  if (!msgEl) msgEl = document.getElementById("msg");
  msgEl.textContent = text;
  msgEl.classList.toggle("alert", !!isAlert);
}

/* ---------- theme ---------- */
function applyTheme(t) {
  document.documentElement.setAttribute("data-theme", t);
  var btn = document.getElementById("themeToggle");
  btn.setAttribute("aria-pressed", t === "dark" ? "true" : "false");
  btn.textContent = "Dark mode: " + (t === "dark" ? "on" : "off");
  try { localStorage.setItem(LS_THEME, t); } catch (e) {}
}
function initTheme() {
  var t = "light";
  try {
    t = localStorage.getItem(LS_THEME) || t;
    if (t !== "dark" && t !== "light") t = "light";
  } catch (e) {}
  applyTheme(t);
  document.getElementById("themeToggle").addEventListener("click", function () {
    var cur = document.documentElement.getAttribute("data-theme");
    applyTheme(cur === "dark" ? "light" : "dark");
  });
}

/* ---------- photos ---------- */
function readFile(f) {
  return new Promise(function (resolve, reject) {
    var r = new FileReader();
    r.onload = function () { resolve(String(r.result)); };
    r.onerror = function () { reject(new Error("read failed")); };
    r.readAsDataURL(f);
  });
}
function downscale(dataURL) {
  return new Promise(function (resolve, reject) {
    var img = new Image();
    img.onload = function () {
      try {
        var max = 1200;
        var s = Math.min(1, max / Math.max(img.width, img.height));
        var cw = Math.max(1, Math.round(img.width * s));
        var ch = Math.max(1, Math.round(img.height * s));
        var c = document.createElement("canvas");
        c.width = cw; c.height = ch;
        c.getContext("2d").drawImage(img, 0, 0, cw, ch);
        var out = c.toDataURL("image/jpeg", 0.7);
        if (!isPhotoURL(out)) { reject(new Error("encode failed")); return; }
        resolve(out);
      } catch (e) { reject(e); }
    };
    img.onerror = function () { reject(new Error("decode failed")); };
    img.src = dataURL;
  });
}
function attachPhotos(files, getTarget, ctxLabel) {
  var chain = Promise.resolve();
  var okCount = 0;
  files.forEach(function (f) {
    chain = chain.then(function () { return readFile(f); })
      .then(function (url) {
        if (!isPhotoURL(url)) throw new Error("unsupported");
        return downscale(url);
      })
      .then(function (small) {
        getTarget().push(small);
        okCount++;
        if (saveState()) { renderRooms(); renderReport(); }
      })
      .catch(function () { /* counted below */ });
  });
  chain.then(function () {
    if (okCount === files.length) say(okCount === 1 ? "Photo attached." : okCount + " photos attached.");
    else if (okCount > 0) say(okCount + " of " + files.length + " photos attached; the rest were an unsupported format.", true);
    else say("No photos attached — unsupported image format.", true);
  });
}
function photoInput(labelText, getTarget, cls) {
  var label = h("label", "filebtn" + (cls ? " " + cls : ""), labelText);
  var input = document.createElement("input");
  input.type = "file";
  input.accept = "image/*";
  input.multiple = true;
  input.className = "visually-hidden";
  input.setAttribute("aria-label", labelText);
  input.addEventListener("change", function () {
    var files = Array.prototype.slice.call(input.files || []);
    if (files.length) attachPhotos(files, getTarget, labelText);
    input.value = "";
  });
  label.appendChild(input);
  return label;
}
function photoGrid(photos, onDelete) {
  var wrap = h("div", "ph-grid");
  photos.forEach(function (url, i) {
    var fig = h("figure", "ph-thumb");
    var img = document.createElement("img");
    img.src = url;              /* allowlisted dataURL only — never innerHTML */
    img.alt = "Attached photo " + (i + 1);
    var del = h("button", "ph-del btn-sm", "Remove");
    del.type = "button";
    del.setAttribute("aria-label", "Delete photo " + (i + 1));
    del.addEventListener("click", function () { onDelete(i); });
    fig.appendChild(img);
    fig.appendChild(del);
    wrap.appendChild(fig);
  });
  return wrap;
}

/* ---------- rooms + defects rendering ---------- */
function ratingFieldset(room) {
  var fs = h("fieldset", "rating");
  fs.appendChild(h("legend", null, "Overall condition"));
  var opts = h("div", "rating-opts");
  RATINGS.forEach(function (r) {
    var lab = h("label");
    var radio = document.createElement("input");
    radio.type = "radio";
    radio.name = "rating-" + room.id;
    radio.value = r;
    if (room.rating === r) radio.checked = true;
    radio.setAttribute("aria-label", room.name + " condition: " + r);
    radio.addEventListener("change", function () {
      room.rating = r;
      saveState();
      renderReport();
    });
    lab.appendChild(radio);
    lab.appendChild(document.createTextNode(r));
    opts.appendChild(lab);
  });
  fs.appendChild(opts);
  return fs;
}

function defectCard(room, d) {
  if (editingDefectId === d.id) return defectEditCard(room, d);
  var card = h("div", "defect");
  card.setAttribute("data-defect", d.id);
  var head = h("div", "defect-head");
  head.appendChild(h("strong", null, d.item || "(untitled)"));
  head.appendChild(h("span", "chip", esc2cap(d.type)));
  head.appendChild(h("span", "chip sev-" + d.severity, d.severity));
  card.appendChild(head);
  if (d.ts) card.appendChild(h("div", "defect-meta", "Logged " + fmtTs(d.ts)));
  if (d.desc) card.appendChild(h("p", "desc", d.desc));
  if (d.photos.length) {
    card.appendChild(h("div", "sec-label", "Photos"));
    card.appendChild(photoGrid(d.photos, function (i) {
      d.photos.splice(i, 1);
      saveState(); renderRooms(); renderReport();
      say("Photo deleted.");
    }));
  }
  card.appendChild(photoInput("Add photo", function () { return d.photos; }));
  var acts = h("div", "defect-actions");
  var editBtn = h("button", "btn btn-secondary btn-sm def-edit", "Edit");
  editBtn.type = "button";
  editBtn.addEventListener("click", function () { editingDefectId = d.id; renderRooms(); });
  var delBtn = h("button", "btn btn-danger btn-sm def-delete", "Delete");
  delBtn.type = "button";
  delBtn.addEventListener("click", function () {
    var ix = room.defects.indexOf(d);
    if (ix !== -1) room.defects.splice(ix, 1);
    saveState(); renderRooms(); renderReport();
    say("Defect deleted.");
  });
  acts.appendChild(editBtn);
  acts.appendChild(delBtn);
  card.appendChild(acts);
  return card;
}

function defectEditCard(room, d) {
  var card = h("div", "defect");
  card.setAttribute("data-defect", d.id);
  card.appendChild(h("div", "sec-label", "Edit defect"));
  var grid = h("div", "form-grid");
  var fItem = h("div", "field");
  fItem.appendChild(h("label", "flabel", "Item / area"));
  var iItem = document.createElement("input");
  iItem.type = "text"; iItem.className = "de-item"; iItem.value = d.item;
  fItem.appendChild(iItem); grid.appendChild(fItem);
  var fType = h("div", "field");
  fType.appendChild(h("label", "flabel", "Defect type"));
  var sType = document.createElement("select"); sType.className = "de-type";
  TYPES.forEach(function (t) {
    var o = document.createElement("option"); o.value = t; o.textContent = esc2cap(t);
    if (t === d.type) o.selected = true; sType.appendChild(o);
  });
  fType.appendChild(sType); grid.appendChild(fType);
  var fSev = h("div", "field");
  fSev.appendChild(h("label", "flabel", "Severity"));
  var sSev = document.createElement("select"); sSev.className = "de-sev";
  SEVS.forEach(function (s) {
    var o = document.createElement("option"); o.value = s; o.textContent = esc2cap(s);
    if (s === d.severity) o.selected = true; sSev.appendChild(o);
  });
  fSev.appendChild(sSev); grid.appendChild(fSev);
  var fDesc = h("div", "field");
  fDesc.appendChild(h("label", "flabel", "Description"));
  var tDesc = document.createElement("textarea"); tDesc.className = "de-desc"; tDesc.value = d.desc;
  fDesc.appendChild(tDesc); grid.appendChild(fDesc);
  card.appendChild(grid);
  var acts = h("div", "defect-actions");
  var saveBtn = h("button", "btn btn-primary btn-sm de-save", "Save changes");
  saveBtn.type = "button";
  saveBtn.addEventListener("click", function () {
    d.item = cap(iItem.value, 120);
    d.type = enumPick(sType.value, TYPES, "other");
    d.severity = enumPick(sSev.value, SEVS, "minor");
    d.desc = cap(tDesc.value, 3000);
    editingDefectId = null;
    saveState(); renderRooms(); renderReport();
    say("Defect updated.");
  });
  var cancelBtn = h("button", "btn btn-secondary btn-sm de-cancel", "Cancel");
  cancelBtn.type = "button";
  cancelBtn.addEventListener("click", function () { editingDefectId = null; renderRooms(); });
  acts.appendChild(saveBtn);
  acts.appendChild(cancelBtn);
  card.appendChild(acts);
  return card;
}

function addDefectForm(room) {
  var box = h("div", "add-defect");
  box.appendChild(h("h4", null, "Log a defect"));
  var grid = h("div", "form-grid");
  var fItem = h("div", "field");
  fItem.appendChild(h("label", "flabel", "Item / area"));
  var iItem = document.createElement("input");
  iItem.type = "text"; iItem.className = "d-item"; iItem.placeholder = "e.g. South wall, Stove, Carpet";
  fItem.appendChild(iItem); grid.appendChild(fItem);
  var fType = h("div", "field");
  fType.appendChild(h("label", "flabel", "Defect type"));
  var sType = document.createElement("select"); sType.className = "d-type";
  TYPES.forEach(function (t) {
    var o = document.createElement("option"); o.value = t; o.textContent = esc2cap(t); sType.appendChild(o);
  });
  fType.appendChild(sType); grid.appendChild(fType);
  var fSev = h("div", "field");
  fSev.appendChild(h("label", "flabel", "Severity"));
  var sSev = document.createElement("select"); sSev.className = "d-sev";
  SEVS.forEach(function (s) {
    var o = document.createElement("option"); o.value = s; o.textContent = esc2cap(s); sSev.appendChild(o);
  });
  fSev.appendChild(sSev); grid.appendChild(fSev);
  var fDesc = h("div", "field");
  fDesc.appendChild(h("label", "flabel", "Description"));
  var tDesc = document.createElement("textarea"); tDesc.className = "d-desc";
  tDesc.placeholder = "What do you see? Where exactly?";
  fDesc.appendChild(tDesc); grid.appendChild(fDesc);
  box.appendChild(grid);
  var addBtn = h("button", "btn btn-secondary d-add", "Add defect");
  addBtn.type = "button";
  addBtn.addEventListener("click", function () {
    var item = cap(iItem.value, 120).trim();
    if (!item) { say("Give the defect an item or area first.", true); iItem.focus(); return; }
    room.defects.push({
      id: uid(),
      item: item,
      type: enumPick(sType.value, TYPES, "other"),
      severity: enumPick(sSev.value, SEVS, "minor"),
      desc: cap(tDesc.value, 3000),
      ts: new Date().toISOString(),
      photos: []
    });
    saveState(); renderRooms(); renderReport();
    say("Defect logged at " + fmtTs(new Date().toISOString()) + ".");
  });
  box.appendChild(addBtn);
  return box;
}

function roomCard(room) {
  var card = h("div", "room-card");
  card.setAttribute("data-room", room.id);
  var head = h("div", "room-head");
  var nameInput = document.createElement("input");
  nameInput.type = "text"; nameInput.className = "room-name"; nameInput.value = room.name;
  nameInput.setAttribute("aria-label", "Room name");
  nameInput.addEventListener("change", function () {
    room.name = cap(nameInput.value, 80).trim() || "Room";
    saveState(); renderReport();
  });
  head.appendChild(nameInput);
  var delRoom = h("button", "btn btn-danger btn-sm room-del", "Delete room");
  delRoom.type = "button";
  delRoom.addEventListener("click", function () {
    if (!window.confirm("Delete the room '" + room.name + "' and all its defects and photos?")) return;
    var ix = state.rooms.indexOf(room);
    if (ix !== -1) state.rooms.splice(ix, 1);
    saveState(); renderRooms(); renderReport();
    say("Room deleted.");
  });
  head.appendChild(delRoom);
  card.appendChild(head);
  card.appendChild(ratingFieldset(room));
  var fNotes = h("div", "field");
  fNotes.appendChild(h("label", "flabel", "Notes"));
  var tNotes = document.createElement("textarea");
  tNotes.className = "room-notes";
  tNotes.value = room.notes;
  tNotes.placeholder = "General condition of this room…";
  tNotes.addEventListener("change", function () {
    room.notes = cap(tNotes.value, 3000);
    saveState(); renderReport();
  });
  fNotes.appendChild(tNotes);
  card.appendChild(fNotes);
  if (room.photos.length) {
    card.appendChild(h("div", "sec-label", "Room photos"));
    card.appendChild(photoGrid(room.photos, function (i) {
      room.photos.splice(i, 1);
      saveState(); renderRooms(); renderReport();
      say("Photo deleted.");
    }));
  }
  card.appendChild(photoInput("Add room photo", function () { return room.photos; }));
  card.appendChild(h("h3", null, "Damage / defects (" + room.defects.length + ")"));
  room.defects.forEach(function (d) { card.appendChild(defectCard(room, d)); });
  card.appendChild(addDefectForm(room));
  return card;
}

function renderRooms() {
  var list = document.getElementById("roomsList");
  while (list.firstChild) list.removeChild(list.firstChild);
  if (!state.rooms.length) {
    var p = h("p", null, "No rooms yet. Add your first room below to start documenting.");
    p.style.color = "var(--muted)";
    list.appendChild(p);
    return;
  }
  state.rooms.forEach(function (r) { list.appendChild(roomCard(r)); });
}

/* ---------- report ---------- */
function renderReport() {
  var rep = document.getElementById("report");
  while (rep.firstChild) rep.removeChild(rep.firstChild);
  var block = h("div", "rep-block");
  block.appendChild(h("h3", null, "Move-In Condition Report"));
  block.appendChild(h("p", "defect-meta", "Generated " + new Date().toLocaleString()));
  var dl = h("dl", "rep-head");
  [["Property address", state.header.address], ["Landlord / manager", state.header.landlord],
   ["Tenant name(s)", state.header.tenants], ["Lease start", state.header.leaseStart],
   ["Move-in date", state.header.moveIn]].forEach(function (pair) {
    dl.appendChild(h("dt", null, pair[0]));
    dl.appendChild(h("dd", null, pair[1] || "—"));
  });
  block.appendChild(dl);
  rep.appendChild(block);

  state.rooms.forEach(function (r, ri) {
    var rb = h("div", "rep-room");
    rb.appendChild(h("h3", null, (ri + 1) + ". " + r.name));
    rb.appendChild(h("p", "defect-meta", "Overall condition: " + (r.rating || "not rated")));
    if (r.notes) rb.appendChild(h("p", null, "Notes: " + r.notes));
    if (r.photos.length) {
      var rt = h("div", "rep-thumbs");
      r.photos.forEach(function (u, i) {
        var img = document.createElement("img");
        img.src = u; img.alt = r.name + " photo " + (i + 1);
        rt.appendChild(img);
      });
      rb.appendChild(rt);
    }
    if (!r.defects.length) {
      rb.appendChild(h("p", "defect-meta", "No defects logged."));
    }
    r.defects.forEach(function (d, di) {
      var dd = h("div", "rep-defect");
      var line = h("p", null, (di + 1) + ". " + (d.item || "(untitled)") + " — " +
        esc2cap(d.type) + " (" + d.severity + ")" + (d.ts ? ", logged " + fmtTs(d.ts) : ""));
      dd.appendChild(line);
      if (d.desc) dd.appendChild(h("p", "desc", d.desc));
      if (d.photos.length) {
        var dt = h("div", "rep-thumbs");
        d.photos.forEach(function (u, i) {
          var img = document.createElement("img");
          img.src = u; img.alt = "Defect photo " + (i + 1);
          dt.appendChild(img);
        });
        dd.appendChild(dt);
      }
      rb.appendChild(dd);
    });
    rep.appendChild(rb);
  });

  var sig = h("div", "rep-block");
  sig.appendChild(h("h3", null, "Signatures"));
  var grid = h("div", "sig-grid");
  [["Tenant", state.header.tenants], ["Landlord / manager", state.header.landlord]].forEach(function (pair) {
    var box = h("div", "sig-box");
    box.appendChild(h("strong", null, pair[0]));
    box.appendChild(h("div", "sig-cap", "Printed name"));
    box.appendChild(h("div", "sig-line", pair[1] || ""));
    box.appendChild(h("div", "sig-cap", "Signature"));
    box.appendChild(h("div", "sig-line"));
    box.appendChild(h("div", "sig-cap", "Date"));
    box.appendChild(h("div", "sig-line"));
    grid.appendChild(box);
  });
  sig.appendChild(grid);
  rep.appendChild(sig);
}

/* ---------- header binding (once; no re-render needed) ---------- */
function syncHeaderInputsToState() {
  /* A prefilled value (browser autofill, prefill script) can sit in an input
     without ever firing a change event. Pull the visible values into state so
     the handover report renders them on load instead of waiting for re-type. */
  var map = { "f-address": "address", "f-landlord": "landlord", "f-tenants": "tenants",
              "f-lease": "leaseStart", "f-movein": "moveIn" };
  var changed = false;
  Object.keys(map).forEach(function (id) {
    var v = cap(document.getElementById(id).value, 300);
    if (v !== state.header[map[id]]) { state.header[map[id]] = v; changed = true; }
  });
  if (changed) saveState();
}
function bindHeader() {
  var map = { "f-address": "address", "f-landlord": "landlord", "f-tenants": "tenants",
              "f-lease": "leaseStart", "f-movein": "moveIn" };
  Object.keys(map).forEach(function (id) {
    var input = document.getElementById(id);
    if (!input.value) input.value = state.header[map[id]] || "";
    input.addEventListener("change", function () {
      state.header[map[id]] = cap(input.value, 300);
      saveState();
      renderReport();
    });
  });
}

/* ---------- export / import ---------- */
function doExport() {
  try {
    var blob = new Blob([JSON.stringify(state, null, 2)], { type: "application/json" });
    var a = document.createElement("a");
    a.href = URL.createObjectURL(blob);
    a.download = "moveinproof-export.json";
    document.body.appendChild(a);
    a.click();
    setTimeout(function () { try { URL.revokeObjectURL(a.href); } catch (e) {} a.remove(); }, 500);
    say("Backup exported.");
  } catch (e) { say("Export failed.", true); }
}
function bindImport() {
  var file = document.getElementById("importFile");
  document.getElementById("importBtn").addEventListener("click", function () { file.click(); });
  file.addEventListener("change", function () {
    var f = file.files && file.files[0];
    if (!f) return;
    var r = new FileReader();
    r.onload = function () {
      try {
        var obj = JSON.parse(String(r.result));
        state = sanitizeState(obj);
        editingDefectId = null;
        saveState(); renderAll();
        say("Import complete.");
      } catch (e) { say("Import failed: not a valid MoveInProof backup.", true); }
    };
    r.onerror = function () { say("Import failed: could not read the file.", true); };
    r.readAsText(f);
    file.value = "";
  });
}

/* ---------- demo / clear ---------- */
function makeDefect(item, type, severity, desc) {
  return { id: uid(), item: item, type: type, severity: severity, desc: desc,
           ts: new Date().toISOString(), photos: [] };
}
function loadDemo() {
  state = {
    header: { address: "123 Example St, Apt 4B, Bloomington, IN", landlord: "Example Property Mgmt",
              leaseStart: todayStr(), moveIn: todayStr(), tenants: "Demo Tenant" },
    rooms: [
      { id: uid(), name: "Living Room", rating: "Good", notes: "Fresh paint; carpet worn near entry.",
        photos: [], defects: [
          makeDefect("South wall", "scuff", "minor", "Scuff marks near the front door, about 2 ft long."),
          makeDefect("Window sill", "crack", "moderate", "Hairline crack along the sill, east window.") ] },
      { id: uid(), name: "Kitchen", rating: "Fair", notes: "Appliances older; grout discolored.",
        photos: [], defects: [
          makeDefect("Countertop", "stain", "moderate", "Dark ring stain near the sink, roughly 4 in across.") ] }
    ]
  };
  editingDefectId = null;
  saveState(); renderAll();
  say("Demo data loaded: 2 rooms, 3 defects. Demo includes no photos.");
}
function clearAll() {
  if (!window.confirm("Delete ALL rooms, defects, photos and the property header? This cannot be undone.")) return;
  state = blankState();
  editingDefectId = null;
  saveState(); renderAll();
  say("Everything cleared.");
}

/* ---------- init ---------- */
function renderAll() {
  bindHeaderValues();
  renderRooms();
  renderReport();
}
function bindHeaderValues() {
  var map = { "f-address": "address", "f-landlord": "landlord", "f-tenants": "tenants",
              "f-lease": "leaseStart", "f-movein": "moveIn" };
  Object.keys(map).forEach(function (id) {
    document.getElementById(id).value = state.header[map[id]] || "";
  });
}
document.addEventListener("DOMContentLoaded", function () {
  initTheme();
  bindHeader();
  syncHeaderInputsToState();
  renderRooms();
  renderReport();
  document.getElementById("addRoomBtn").addEventListener("click", function () {
    var input = document.getElementById("addRoomName");
    var name = cap(input.value, 80).trim();
    if (!name) { say("Type a room name first.", true); input.focus(); return; }
    state.rooms.push({ id: uid(), name: name, rating: "", notes: "", photos: [], defects: [] });
    input.value = "";
    saveState(); renderRooms(); renderReport();
    say("Room '" + name + "' added.");
  });
  document.getElementById("addRoomName").addEventListener("keydown", function (e) {
    if (e.key === "Enter") { e.preventDefault(); document.getElementById("addRoomBtn").click(); }
  });
  document.getElementById("printBtn").addEventListener("click", function () { window.print(); });
  document.getElementById("exportBtn").addEventListener("click", doExport);
  bindImport();
  document.getElementById("demoBtn").addEventListener("click", loadDemo);
  document.getElementById("clearBtn").addEventListener("click", clearAll);
});
</script>
