<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>PackTrack — Moving Box Inventory Indexer</title>
<meta name="description" content="PackTrack: track your moving boxes room by room, search contents instantly, print box labels. Free offline tool by Glenerds.">
<style>
/* ============ Theme variables ============ */
:root {
  color-scheme: light;
  --bg: #f4f5f7;
  --bg-elev: #ffffff;
  --bg-input: #ffffff;
  --text: #1c1f24;
  --text-muted: #5b626e;
  --border: #d7dbe1;
  --accent: #1d6fe0;
  --accent-ink: #ffffff;
  --accent-soft: #e3eefc;
  --danger: #c2372b;
  --danger-soft: #f9e4e1;
  --ok: #1c7a3d;
  --ok-soft: #e0f1e5;
  --warn: #a8620a;
  --warn-soft: #f9eed9;
  --fragile: #b3202f;
  --fragile-soft: #fbe8ea;
  --tag-blue: #dbeafe; --tag-green: #dcfce7; --tag-red: #fee2e2;
  --tag-yellow: #fef3c7; --tag-purple: #ede9fe; --tag-gray: #e5e7eb;
  --shadow: 0 1px 3px rgba(0,0,0,.08);
  --radius: 10px;
}
html[data-theme="dark"] {
  color-scheme: dark;
  --bg: #14171c;
  --bg-elev: #1d2128;
  --bg-input: #232830;
  --text: #e8ebef;
  --text-muted: #a3aab6;
  --border: #363c46;
  --accent: #4d97f2;
  --accent-ink: #0a1220;
  --accent-soft: #22384f;
  --danger: #ef6b5c;
  --danger-soft: #3a2226;
  --ok: #5ec87e;
  --ok-soft: #1d3226;
  --warn: #e0a53e;
  --warn-soft: #3a2f18;
  --fragile: #f26b7d;
  --fragile-soft: #3a2226;
  --tag-blue: #1e3a5f; --tag-green: #1d4a2c; --tag-red: #5b2626;
  --tag-yellow: #5b4718; --tag-purple: #3d3260; --tag-gray: #3a3f47;
  --shadow: 0 1px 3px rgba(0,0,0,.35);
}

/* ============ Base ============ */
* { box-sizing: border-box; }
body {
  margin: 0;
  font-family: system-ui, -apple-system, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
  background: var(--bg);
  color: var(--text);
  line-height: 1.5;
}
.skip-link { position: absolute; left: -9999px; }
.skip-link:focus { left: 8px; top: 8px; background: var(--accent); color: var(--accent-ink); padding: 8px 12px; border-radius: 6px; z-index: 99; }

.app-header {
  background: var(--bg-elev);
  border-bottom: 1px solid var(--border);
  padding: 12px 16px;
  display: flex; align-items: center; gap: 12px; flex-wrap: wrap;
  position: sticky; top: 0; z-index: 10;
}
.app-header h1 { font-size: 1.35rem; margin: 0; letter-spacing: -0.01em; }
.app-header .tagline { color: var(--text-muted); font-size: .85rem; margin: 0; }
.theme-toggle { margin-left: auto; }
button, input[type="text"], input[type="number"], select, textarea {
  font: inherit;
  color: var(--text);
}
input[type="text"], input[type="number"], select {
  background: var(--bg-input);
  border: 1px solid var(--border);
  border-radius: 8px;
  padding: 8px 10px;
}
input[type="text"]:focus, input[type="number"]:focus, select:focus, button:focus-visible {
  outline: 2px solid var(--accent);
  outline-offset: 1px;
}
button {
  background: var(--bg-input);
  border: 1px solid var(--border);
  border-radius: 8px;
  padding: 8px 12px;
  cursor: pointer;
  box-shadow: var(--shadow);
}
button:hover { border-color: var(--accent); }
button.primary { background: var(--accent); color: var(--accent-ink); border-color: var(--accent); font-weight: 600; }
button.danger { color: var(--danger); border-color: var(--danger); }
button.small { padding: 4px 8px; font-size: .85rem; }
button[disabled] { opacity: .5; cursor: not-allowed; }

main { max-width: 1024px; margin: 0 auto; padding: 16px; }
section { margin-bottom: 28px; }
section > h2 { font-size: 1.15rem; margin: 0 0 10px; }

.card {
  background: var(--bg-elev);
  border: 1px solid var(--border);
  border-radius: var(--radius);
  padding: 14px;
  box-shadow: var(--shadow);
}

/* ============ Dashboard ============ */
.stat-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(120px, 1fr));
  gap: 10px;
  margin-bottom: 10px;
}
.stat {
  background: var(--bg-elev);
  border: 1px solid var(--border);
  border-radius: var(--radius);
  padding: 10px 12px;
}
.stat .num { font-size: 1.6rem; font-weight: 700; }
.stat .lbl { color: var(--text-muted); font-size: .8rem; }
.room-counts { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 8px; }
.room-pill {
  background: var(--bg-elev); border: 1px solid var(--border);
  border-radius: 999px; padding: 4px 12px; font-size: .85rem;
}
.room-pill b { margin-left: 4px; }
.progress-wrap { margin-top: 12px; }
progress { width: 100%; height: 14px; accent-color: var(--ok); }
.progress-label { font-size: .85rem; color: var(--text-muted); }

/* ============ Search ============ */
.search-wrap { display: flex; gap: 8px; flex-wrap: wrap; }
.search-wrap input[type="search"] {
  flex: 1 1 220px;
  background: var(--bg-input); border: 1px solid var(--border);
  border-radius: 8px; padding: 10px 12px; font-size: 1rem; color: var(--text);
}
.search-results { margin-top: 12px; display: grid; gap: 8px; }
.search-hit { border-left: 4px solid var(--accent); }
.search-hit .snip { color: var(--text-muted); font-size: .9rem; }
mark { background: var(--warn-soft); color: var(--text); border-radius: 2px; padding: 0 2px; }
html[data-theme="dark"] mark { background: #5b4718; }
.empty { color: var(--text-muted); font-style: italic; }

/* ============ New box form ============ */
.new-box-form { display: grid; gap: 10px; grid-template-columns: repeat(auto-fit, minmax(160px, 1fr)); align-items: end; }
.field { display: flex; flex-direction: column; gap: 4px; }
.field label { font-size: .85rem; font-weight: 600; }
.checkbox-row { display: flex; align-items: center; gap: 8px; padding-bottom: 8px; }
.form-actions { display: flex; gap: 8px; flex-wrap: wrap; margin-top: 6px; }
.color-swatch-row { display: flex; gap: 6px; flex-wrap: wrap; }
.color-swatch {
  width: 30px; height: 30px; border-radius: 50%;
  border: 2px solid transparent; cursor: pointer; padding: 0;
}
.color-swatch[aria-pressed="true"] { border-color: var(--accent); outline: 2px solid var(--accent); outline-offset: 1px; }
.color-swatch.none { background: var(--bg-input); border-color: var(--border); position: relative; }
.color-swatch.none::after { content: "–"; color: var(--text-muted); font-weight: bold; }

/* ============ Boxes list ============ */
.boxes-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(300px, 1fr)); gap: 12px; }
.box-card { display: flex; flex-direction: column; gap: 8px; }
.box-head { display: flex; align-items: center; gap: 8px; flex-wrap: wrap; }
.box-number { font-size: 1.25rem; font-weight: 800; }
.box-room { color: var(--text-muted); font-size: .9rem; }
.box-tag {
  font-size: .75rem; font-weight: 700; padding: 2px 8px; border-radius: 999px;
  background: var(--tag-gray); color: var(--text);
}
.box-tag[data-color="blue"] { background: var(--tag-blue); }
.box-tag[data-color="green"] { background: var(--tag-green); }
.box-tag[data-color="red"] { background: var(--tag-red); }
.box-tag[data-color="yellow"] { background: var(--tag-yellow); }
.box-tag[data-color="purple"] { background: var(--tag-purple); }
.box-fragile {
  font-size: .75rem; font-weight: 800; color: var(--fragile);
  background: var(--fragile-soft); border: 1px solid var(--fragile);
  padding: 2px 8px; border-radius: 999px; text-transform: uppercase; letter-spacing: .04em;
}
.box-status { font-size: .8rem; font-weight: 600; }
.box-status.packed { color: var(--ok); }
.box-status.open { color: var(--warn); }
.item-list { list-style: none; margin: 0; padding: 0; display: grid; gap: 4px; }
.item-list li {
  display: flex; align-items: center; gap: 8px;
  border: 1px solid var(--border); border-radius: 6px; padding: 6px 8px;
  font-size: .95rem;
}
.item-list li .item-text { flex: 1; overflow-wrap: anywhere; }
.item-list li.unpacked .item-text { text-decoration: line-through; color: var(--text-muted); }
.item-remove { padding: 2px 8px; font-size: .8rem; }
.add-item-row { display: flex; gap: 6px; }
.add-item-row input { flex: 1; min-width: 0; }
.box-actions { display: flex; gap: 6px; flex-wrap: wrap; }
.item-count { font-size: .85rem; color: var(--text-muted); }
.toolbar { display: flex; gap: 8px; flex-wrap: wrap; align-items: center; margin-bottom: 12px; }
.mode-toggle[aria-pressed="true"] { background: var(--accent-soft); border-color: var(--accent); font-weight: 700; }

/* ============ Footer ============ */
.app-footer {
  border-top: 1px solid var(--border);
  padding: 16px;
  text-align: center;
  color: var(--text-muted);
  font-size: .85rem;
}
.app-footer a { color: var(--accent); }

/* ============ Screen-only print label ============ */
.print-label { display: none; }

/* ============ Print stylesheet ============ */
@media print {
  body.printing-label > *:not(.print-label) { display: none !important; }
  body.printing-label .print-label { display: block; }
  .print-label { page-break-after: always; }
  .pl-box {
    width: 100%; min-height: 90vh;
    border: 6px solid #000; border-radius: 12px;
    padding: 40px 32px; text-align: center;
    display: flex; flex-direction: column; justify-content: center;
  }
  .pl-number { font-size: 140pt; font-weight: 900; line-height: 1; margin: 0; }
  .pl-room { font-size: 40pt; font-weight: 700; margin: 12px 0 0; }
  .pl-tag { font-size: 28pt; margin: 8px 0 0; }
  .pl-fragile {
    font-size: 48pt; font-weight: 900; color: #000; margin: 16px 0 0;
    border: 4px solid #000; display: inline-block; padding: 4px 24px;
    text-transform: uppercase; letter-spacing: .08em;
  }
  .pl-items { text-align: left; font-size: 20pt; margin: 24px auto 0; max-width: 7in; }
  .pl-items li { margin-bottom: 6px; }
  .pl-count { font-size: 18pt; color: #333; margin-top: 12px; }
}
</style>
</head>
<body>
<a class="skip-link" href="#main">Skip to main content</a>

<header class="app-header">
  <div>
    <h1>PackTrack</h1>
    <p class="tagline">Moving box inventory — know where everything is packed.</p>
  </div>
  <button type="button" class="theme-toggle" id="theme-toggle" aria-label="Toggle dark mode">Dark mode</button>
</header>

<main id="main">

  <!-- Dashboard -->
  <section aria-labelledby="dash-h">
    <h2 id="dash-h">Dashboard</h2>
    <div class="stat-grid" id="stat-grid" role="group" aria-label="Totals"></div>
    <div class="room-counts" id="room-counts" aria-label="Boxes per room"></div>
    <div class="progress-wrap">
      <progress id="unpack-progress" max="100" value="0" aria-label="Unpacking progress"></progress>
      <div class="progress-label" id="unpack-label"></div>
    </div>
  </section>

  <!-- Search -->
  <section aria-labelledby="search-h">
    <h2 id="search-h">Find an item</h2>
    <div class="search-wrap">
      <input type="search" id="search" placeholder="Type an item name, e.g. HDMI cable" aria-label="Search box contents" autocomplete="off">
      <button type="button" id="search-clear">Clear</button>
    </div>
    <div class="search-results" id="search-results" aria-live="polite" aria-atomic="false"></div>
  </section>

  <!-- New box -->
  <section aria-labelledby="newbox-h">
    <h2 id="newbox-h">Add a box</h2>
    <form class="card new-box-form" id="new-box-form" novalidate>
      <div class="field">
        <label for="nb-number">Box number</label>
        <input type="number" id="nb-number" min="1" max="9999" step="1" required>
      </div>
      <div class="field">
        <label for="nb-room">Room</label>
        <select id="nb-room"></select>
      </div>
      <div class="field">
        <label for="nb-new-room">New room (optional)</label>
        <input type="text" id="nb-new-room" maxlength="40" placeholder="e.g. Nursery">
      </div>
      <div class="field">
        <label for="nb-label">Label / color tag</label>
        <input type="text" id="nb-label" maxlength="40" placeholder="e.g. Books, cables">
      </div>
      <div class="field">
        <label>Color tag</label>
        <div class="color-swatch-row" id="nb-colors" role="group" aria-label="Color tag choice"></div>
      </div>
      <div class="checkbox-row">
        <input type="checkbox" id="nb-fragile">
        <label for="nb-fragile">Fragile</label>
      </div>
      <div class="form-actions" style="grid-column: 1 / -1;">
        <button type="submit" class="primary">Add box</button>
        <button type="reset" id="nb-reset">Reset</button>
      </div>
      <p class="empty" id="nb-error" role="alert" hidden style="grid-column: 1 / -1; color: var(--danger); font-style: normal;"></p>
    </form>
  </section>

  <!-- Boxes -->
  <section aria-labelledby="boxes-h">
    <h2 id="boxes-h">Boxes</h2>
    <div class="toolbar">
      <button type="button" id="unpack-mode" class="mode-toggle" aria-pressed="false">Unpack mode: off</button>
      <button type="button" id="print-all">Print all labels</button>
      <span class="item-count" id="boxes-empty-note"></span>
    </div>
    <div class="boxes-grid" id="boxes-grid"></div>
  </section>

  <!-- Data -->
  <section aria-labelledby="data-h">
    <h2 id="data-h">Backup &amp; demo</h2>
    <div class="card" style="display:flex; gap:8px; flex-wrap:wrap;">
      <button type="button" id="export-btn">Export JSON</button>
      <button type="button" id="import-btn">Import JSON</button>
      <input type="file" id="import-file" accept="application/json,.json" hidden aria-label="Choose JSON backup file">
      <button type="button" id="demo-btn">Load demo data</button>
      <button type="button" class="danger" id="clear-btn">Clear all data</button>
    </div>
    <p class="empty" id="export-status" role="status" aria-live="polite" style="margin:8px 0 0;"></p>
    <p class="empty" id="data-note">Data is stored only in this browser (localStorage). Export a JSON backup before moving day.</p>
  </section>

</main>

<footer class="app-footer">
  <a href="https://glenerds.gumroad.com">by Glenerds</a> &nbsp;·&nbsp; Single-file offline app — your data never leaves this browser.
</footer>

<!-- Screen-hidden label printed on demand -->
<div class="print-label" id="print-label" aria-hidden="true"></div>

<script>
"use strict";
/* ===================== PackTrack =====================
   Single-file, offline, zero external requests.
   Security: no innerHTML with user/imported data anywhere.
   All user strings enter the DOM via textContent or .value.
------------------------------------------------------ */

// ---------- Constants ----------
const LS_KEY = "packtrack-v1";
const THEME_KEY = "packtrack-theme";
const DEFAULT_ROOMS = ["Living Room", "Kitchen", "Bedroom", "Bathroom", "Office", "Garage", "Storage", "Other"];
const COLOR_TAGS = ["", "blue", "green", "red", "yellow", "purple"];
const LIMITS = { numberMin: 1, numberMax: 9999, roomLen: 40, labelLen: 40, itemLen: 120, maxBoxes: 500, maxItemsPerBox: 300, maxRooms: 50 };

// ---------- State ----------
let state = { boxes: [], customRooms: [], nextNumber: 101 };
let unpackMode = false;
let selectedColor = "";

// ---------- Sanitizers ----------
function cleanStr(v, max) {
  if (typeof v !== "string") return "";
  return v.trim().slice(0, max);
}
function cleanNum(v, min, max, fallback) {
  const n = Number(v);
  if (!Number.isFinite(n)) return fallback;
  const i = Math.floor(n);
  if (i < min || i > max) return fallback;
  return i;
}
function isValidColor(c) { return COLOR_TAGS.includes(c); }

function sanitizeBox(raw) {
  if (!raw || typeof raw !== "object") return null;
  const number = cleanNum(raw.number, LIMITS.numberMin, LIMITS.numberMax, null);
  if (number === null) return null;
  const room = cleanStr(raw.room, LIMITS.roomLen) || "Other";
  const label = cleanStr(raw.label, LIMITS.labelLen);
  const color = isValidColor(raw.color) ? raw.color : "";
  const fragile = raw.fragile === true;
  const packed = raw.packed === true;
  const items = [];
  if (Array.isArray(raw.items)) {
    for (const it of raw.items.slice(0, LIMITS.maxItemsPerBox)) {
      const text = typeof it === "string" ? cleanStr(it, LIMITS.itemLen) : cleanStr(it && it.text, LIMITS.itemLen);
      if (text) items.push({ text, unpacked: !!(it && typeof it === "object" && it.unpacked === true) });
    }
  }
  return { number, room, label, color, fragile, packed, items };
}

function sanitizeState(raw) {
  const out = { boxes: [], customRooms: [], nextNumber: 101 };
  if (!raw || typeof raw !== "object") return out;
  const seen = new Set();
  if (Array.isArray(raw.boxes)) {
    for (const b of raw.boxes.slice(0, LIMITS.maxBoxes)) {
      const box = sanitizeBox(b);
      if (box && !seen.has(box.number)) { seen.add(box.number); out.boxes.push(box); }
    }
  }
  if (Array.isArray(raw.customRooms)) {
    for (const r of raw.customRooms.slice(0, LIMITS.maxRooms)) {
      const room = cleanStr(r, LIMITS.roomLen);
      if (room && !DEFAULT_ROOMS.includes(room) && !out.customRooms.includes(room)) out.customRooms.push(room);
    }
  }
  if (raw.nextNumber === undefined || raw.nextNumber === null) {
    const max = out.boxes.reduce((m, b) => Math.max(m, b.number), 100);
    out.nextNumber = Math.min(Math.max(max + 1, LIMITS.numberMin), LIMITS.numberMax);
  } else {
    out.nextNumber = cleanNum(raw.nextNumber, LIMITS.numberMin, LIMITS.numberMax, 101);
  }
  return out;
}

// ---------- Persistence ----------
function save() {
  try { localStorage.setItem(LS_KEY, JSON.stringify(state)); }
  catch (e) { /* storage full/blocked — app still works in memory */ }
}
function load() {
  try {
    const raw = localStorage.getItem(LS_KEY);
    if (raw) state = sanitizeState(JSON.parse(raw));
  } catch (e) { /* corrupted JSON — start fresh */ }
}

// ---------- DOM helpers (no innerHTML with user data) ----------
function el(tag, className) {
  const n = document.createElement(tag);
  if (className) n.className = className;
  return n;
}
function txt(parent, s) { parent.appendChild(document.createTextNode(s)); }
function labeledValue(parent, labelText, value) {
  const d = el("div");
  const b = el("strong"); txt(b, labelText + ": ");
  d.appendChild(b); txt(d, value);
  parent.appendChild(d);
}

// ---------- Theme ----------
function applyTheme(mode) {
  document.documentElement.setAttribute("data-theme", mode);
  const btn = document.getElementById("theme-toggle");
  btn.textContent = mode === "dark" ? "Light mode" : "Dark mode";
  btn.setAttribute("aria-label", mode === "dark" ? "Switch to light mode" : "Switch to dark mode");
  try { localStorage.setItem(THEME_KEY, mode); } catch (e) {}
}
function initTheme() {
  let saved = null;
  try { saved = localStorage.getItem(THEME_KEY); } catch (e) {}
  const mode = saved === "dark" || saved === "light"
    ? saved
    : (window.matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light");
  applyTheme(mode);
  document.getElementById("theme-toggle").addEventListener("click", () => {
    const cur = document.documentElement.getAttribute("data-theme");
    applyTheme(cur === "dark" ? "light" : "dark");
  });
}

// ---------- Rooms ----------
function allRooms() { return DEFAULT_ROOMS.concat(state.customRooms); }
function refreshRoomSelect(keep) {
  const sel = document.getElementById("nb-room");
  while (sel.firstChild) sel.removeChild(sel.firstChild);
  for (const r of allRooms()) {
    const opt = document.createElement("option");
    opt.value = r; opt.textContent = r;
    sel.appendChild(opt);
  }
  if (keep && allRooms().includes(keep)) sel.value = keep;
}

// ---------- Dashboard ----------
function renderDashboard() {
  const grid = document.getElementById("stat-grid");
  while (grid.firstChild) grid.removeChild(grid.firstChild);
  const boxes = state.boxes;
  const totalItems = boxes.reduce((a, b) => a + b.items.length, 0);
  const packed = boxes.filter(b => b.packed).length;
  const unpackedBoxes = boxes.filter(b => b.packed && b.items.length && b.items.every(i => i.unpacked)).length;
  const stats = [
    ["Boxes", boxes.length],
    ["Items", totalItems],
    ["Packed", packed],
    ["Open", boxes.length - packed],
    ["Fully unpacked", unpackedBoxes]
  ];
  for (const [lbl, n] of stats) {
    const s = el("div", "stat");
    const num = el("div", "num"); txt(num, String(n));
    const lab = el("div", "lbl"); txt(lab, lbl);
    s.appendChild(num); s.appendChild(lab);
    grid.appendChild(s);
  }
  const rc = document.getElementById("room-counts");
  while (rc.firstChild) rc.removeChild(rc.firstChild);
  for (const r of allRooms()) {
    const c = boxes.filter(b => b.room === r).length;
    if (!c) continue;
    const pill = el("span", "room-pill");
    txt(pill, r + " ");
    const b = el("b"); txt(b, String(c));
    pill.appendChild(b);
    rc.appendChild(pill);
  }
  // unpack progress across packed boxes
  let uTotal = 0, uDone = 0;
  for (const b of boxes) { for (const i of b.items) { uTotal++; if (i.unpacked) uDone++; } }
  const pct = uTotal ? Math.round((uDone / uTotal) * 100) : 0;
  const bar = document.getElementById("unpack-progress");
  bar.value = pct;
  const lbl = document.getElementById("unpack-label");
  lbl.textContent = "";
  txt(lbl, uTotal ? `Unpacked ${uDone} of ${uTotal} items (${pct}%)` : "No items packed yet — add a box to get started.");
}

// ---------- Search ----------
function highlightMatch(parent, text, query) {
  const lower = text.toLowerCase(), q = query.toLowerCase();
  let idx = 0, pos = lower.indexOf(q);
  if (pos === -1) { txt(parent, text); return; }
  while (pos !== -1) {
    if (pos > idx) parent.appendChild(document.createTextNode(text.slice(idx, pos)));
    const m = document.createElement("mark");
    m.textContent = text.slice(pos, pos + q.length);
    parent.appendChild(m);
    idx = pos + q.length;
    pos = lower.indexOf(q, idx);
  }
  if (idx < text.length) parent.appendChild(document.createTextNode(text.slice(idx)));
}
function runSearch() {
  const q = document.getElementById("search").value.trim();
  const out = document.getElementById("search-results");
  while (out.firstChild) out.removeChild(out.firstChild);
  if (!q) return;
  const lower = q.toLowerCase();
  let hits = 0;
  for (const b of state.boxes) {
    const matched = b.items.filter(i => i.text.toLowerCase().includes(lower));
    const roomHit = b.room.toLowerCase().includes(lower) || (b.label && b.label.toLowerCase().includes(lower));
    if (!matched.length && !roomHit) continue;
    hits++;
    const card = el("div", "card search-hit");
    const head = el("div", "box-head");
    const num = el("span", "box-number"); txt(num, "Box " + b.number);
    const room = el("span", "box-room"); txt(room, b.room + (b.packed ? " · sealed" : " · open"));
    head.appendChild(num); head.appendChild(room);
    card.appendChild(head);
    if (matched.length) {
      const snip = el("div", "snip");
      const show = matched.slice(0, 4);
      show.forEach((i, k) => {
        if (k) txt(snip, " · ");
        highlightMatch(snip, i.text, q);
      });
      if (matched.length > 4) txt(snip, ` (+${matched.length - 4} more)`);
      card.appendChild(snip);
    } else {
      const snip = el("div", "snip");
      txt(snip, "Room/label match — no item matched.");
      card.appendChild(snip);
    }
    out.appendChild(card);
  }
  if (!hits) {
    const p = el("p", "empty"); txt(p, `No items found for "${q}".`);
    out.appendChild(p);
  }
}

// ---------- Box cards ----------
function addItem(box, text) {
  const t = cleanStr(text, LIMITS.itemLen);
  if (!t || box.items.length >= LIMITS.maxItemsPerBox) return false;
  box.items.push({ text: t, unpacked: false });
  save();
  return true;
}
function renderBoxes() {
  const grid = document.getElementById("boxes-grid");
  while (grid.firstChild) grid.removeChild(grid.firstChild);
  const note = document.getElementById("boxes-empty-note");
  note.textContent = "";
  if (!state.boxes.length) {
    txt(note, "No boxes yet — add your first box above, or load the demo data below.");
    return;
  }
  const sorted = state.boxes.slice().sort((a, b) => a.number - b.number);
  for (const b of sorted) renderBoxCard(grid, b);
}
function renderBoxCard(grid, box) {
  const card = el("article", "card box-card");

  const head = el("div", "box-head");
  const num = el("span", "box-number"); txt(num, "Box " + box.number);
  const room = el("span", "box-room"); txt(room, box.room);
  head.appendChild(num); head.appendChild(room);
  if (box.label) {
    const tag = el("span", "box-tag");
    if (box.color) tag.setAttribute("data-color", box.color);
    txt(tag, box.label);
    head.appendChild(tag);
  }
  if (box.fragile) {
    const f = el("span", "box-fragile"); txt(f, "Fragile");
    head.appendChild(f);
  }
  const st = el("span", "box-status " + (box.packed ? "packed" : "open"));
  txt(st, box.packed ? "Sealed" : "Open");
  head.appendChild(st);
  card.appendChild(head);

  const cnt = el("span", "item-count");
  txt(cnt, `${box.items.length} item${box.items.length === 1 ? "" : "s"}`);
  card.appendChild(cnt);

  // items
  const list = el("ul", "item-list");
  box.items.forEach((item, idx) => {
    const li = el("li");
    if (item.unpacked) li.className += " unpacked";
    if (unpackMode) {
      const cb = document.createElement("input");
      cb.type = "checkbox";
      cb.checked = item.unpacked;
      cb.setAttribute("aria-label", "Mark unpacked: " + item.text);
      cb.addEventListener("change", () => { item.unpacked = cb.checked; save(); renderAll(); });
      li.appendChild(cb);
    }
    const span = el("span", "item-text"); txt(span, item.text);
    li.appendChild(span);
    const rm = el("button", "item-remove small");
    rm.type = "button";
    txt(rm, "Remove");
    rm.setAttribute("aria-label", "Remove item " + item.text);
    rm.addEventListener("click", () => { box.items.splice(idx, 1); save(); renderAll(); runSearch(); });
    li.appendChild(rm);
    list.appendChild(li);
  });
  card.appendChild(list);

  // add item
  const addRow = el("div", "add-item-row");
  const inp = document.createElement("input");
  inp.type = "text";
  inp.placeholder = "Add an item (Enter to add)";
  inp.maxLength = LIMITS.itemLen;
  inp.setAttribute("aria-label", "Add item to box " + box.number);
  const addBtn = el("button", "small");
  addBtn.type = "button";
  txt(addBtn, "Add");
  const commit = () => {
    if (addItem(box, inp.value)) {
      const num = box.number;
      renderAll(); runSearch();
      const fresh = document.querySelector('input[aria-label="Add item to box ' + num + '"]');
      if (fresh) fresh.focus();
    }
  };
  addBtn.addEventListener("click", commit);
  inp.addEventListener("keydown", e => { if (e.key === "Enter") { e.preventDefault(); commit(); } });
  addRow.appendChild(inp); addRow.appendChild(addBtn);
  card.appendChild(addRow);

  // actions
  const actions = el("div", "box-actions");
  const sealBtn = el("button", "small");
  sealBtn.type = "button";
  txt(sealBtn, box.packed ? "Unseal" : "Seal box");
  sealBtn.addEventListener("click", () => { box.packed = !box.packed; save(); renderAll(); runSearch(); });
  actions.appendChild(sealBtn);

  const printBtn = el("button", "small");
  printBtn.type = "button";
  txt(printBtn, "Print label");
  printBtn.addEventListener("click", () => printLabel(box));
  actions.appendChild(printBtn);

  const delBtn = el("button", "small danger");
  delBtn.type = "button";
  txt(delBtn, "Delete box");
  delBtn.addEventListener("click", () => {
    if (window.confirm(`Delete Box ${box.number} and all its items?`)) {
      state.boxes = state.boxes.filter(x => x !== box);
      save(); renderAll(); runSearch();
    }
  });
  actions.appendChild(delBtn);
  card.appendChild(actions);

  grid.appendChild(card);
}

// ---------- Print label ----------
function buildLabel(labelHost, box) {
  while (labelHost.firstChild) labelHost.removeChild(labelHost.firstChild);
  const wrap = el("div", "pl-box");
  const num = el("p", "pl-number"); txt(num, "Box " + box.number);
  wrap.appendChild(num);
  const room = el("p", "pl-room"); txt(room, box.room);
  wrap.appendChild(room);
  if (box.label) { const t = el("p", "pl-tag"); txt(t, box.label); wrap.appendChild(t); }
  if (box.fragile) { const f = el("p", "pl-fragile"); txt(f, "Fragile"); wrap.appendChild(f); }
  if (box.items.length) {
    const ul = el("ul", "pl-items");
    for (const i of box.items) { const li = el("li"); txt(li, i.text); ul.appendChild(li); }
    wrap.appendChild(ul);
  }
  const c = el("p", "pl-count");
  txt(c, box.items.length + " item" + (box.items.length === 1 ? "" : "s"));
  wrap.appendChild(c);
  labelHost.appendChild(wrap);
}
function printLabel(box) {
  const host = document.getElementById("print-label");
  buildLabel(host, box);
  document.body.classList.add("printing-label");
  window.print();
  // remove class after print dialog closes so the app reappears
  const done = () => {
    document.body.classList.remove("printing-label");
    window.removeEventListener("afterprint", done);
  };
  window.addEventListener("afterprint", done);
  // fallback if afterprint never fires
  setTimeout(() => document.body.classList.remove("printing-label"), 2000);
}

// ---------- Export / Import ----------
function exportJSON() {
  const blob = new Blob([JSON.stringify(state, null, 2)], { type: "application/json" });
  const a = document.createElement("a");
  a.href = URL.createObjectURL(blob);
  a.download = "packtrack-backup.json";
  document.body.appendChild(a);
  a.click();
  setTimeout(() => { URL.revokeObjectURL(a.href); a.remove(); }, 500);
  const st = document.getElementById("export-status");
  st.textContent = "";
  const n = state.boxes.length;
  txt(st, `Exported ${n} box${n === 1 ? "" : "es"} — download started (packtrack-backup.json).`);
}
function importJSON(file) {
  const reader = new FileReader();
  reader.onload = () => {
    try {
      const parsed = sanitizeState(JSON.parse(String(reader.result)));
      state = parsed;
      save();
      refreshRoomSelect();
      document.getElementById("nb-number").value = state.nextNumber;
      renderAll(); runSearch();
      alert("Import complete: " + state.boxes.length + " boxes loaded.");
    } catch (e) {
      alert("Import failed: that file is not a valid PackTrack backup.");
    }
  };
  reader.readAsText(file);
}

