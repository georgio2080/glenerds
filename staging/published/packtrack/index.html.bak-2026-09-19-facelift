// ---------- New box form ----------
function initNewBoxForm() {
  const form = document.getElementById("new-box-form");
  const err = document.getElementById("nb-error");
  document.getElementById("nb-number").value = state.nextNumber;

  // color swatches
  const row = document.getElementById("nb-colors");
  const colors = { "": "No color", blue: "Blue", green: "Green", red: "Red", yellow: "Yellow", purple: "Purple" };
  for (const c of COLOR_TAGS) {
    const sw = el("button", "color-swatch" + (c === "" ? " none" : ""));
    sw.type = "button";
    sw.setAttribute("aria-pressed", c === selectedColor ? "true" : "false");
    sw.setAttribute("aria-label", "Color tag: " + colors[c]);
    sw.title = colors[c];
    if (c) sw.style.background = { blue: "#3b82f6", green: "#22c55e", red: "#ef4444", yellow: "#eab308", purple: "#a855f7" }[c];
    sw.addEventListener("click", () => {
      selectedColor = c;
      for (const s of row.children) s.setAttribute("aria-pressed", s === sw ? "true" : "false");
    });
    row.appendChild(sw);
  }

  form.addEventListener("submit", e => {
    e.preventDefault();
    err.hidden = true;
    const numInput = document.getElementById("nb-number");
    const number = cleanNum(numInput.value, LIMITS.numberMin, LIMITS.numberMax, null);
    if (number === null) {
      err.textContent = "Enter a box number between 1 and 9999.";
      err.hidden = false; numInput.focus(); return;
    }
    if (state.boxes.some(b => b.number === number)) {
      err.textContent = "Box " + number + " already exists. Pick another number.";
      err.hidden = false; numInput.focus(); return;
    }
    if (state.boxes.length >= LIMITS.maxBoxes) {
      err.textContent = "Box limit reached (500). Delete a box first.";
      err.hidden = false; return;
    }
    const newRoom = cleanStr(document.getElementById("nb-new-room").value, LIMITS.roomLen);
    let room = document.getElementById("nb-room").value;
    if (newRoom) {
      room = newRoom;
      if (!allRooms().includes(room)) {
        if (state.customRooms.length >= LIMITS.maxRooms) {
          err.textContent = "Too many custom rooms — pick an existing one.";
          err.hidden = false; return;
        }
        state.customRooms.push(room);
        refreshRoomSelect(room);
      }
    }
    const box = {
      number,
      room,
      label: cleanStr(document.getElementById("nb-label").value, LIMITS.labelLen),
      color: selectedColor,
      fragile: document.getElementById("nb-fragile").checked,
      packed: false,
      items: []
    };
    state.boxes.push(box);
    if (number >= state.nextNumber) state.nextNumber = number + 1;
    save();
    form.reset();
    refreshRoomSelect(room);
    document.getElementById("nb-number").value = state.nextNumber;
    selectedColor = "";
    for (const s of row.children) s.setAttribute("aria-pressed", s === row.children[0] ? "true" : "false");
    renderAll(); runSearch();
  });
  form.addEventListener("reset", () => {
    selectedColor = "";
    for (const s of row.children) s.setAttribute("aria-pressed", s === row.children[0] ? "true" : "false");
  });
}

// ---------- Toolbar ----------
function initToolbar() {
  const um = document.getElementById("unpack-mode");
  um.addEventListener("click", () => {
    unpackMode = !unpackMode;
    um.setAttribute("aria-pressed", String(unpackMode));
    um.textContent = "Unpack mode: " + (unpackMode ? "on" : "off");
    renderAll();
  });
  document.getElementById("print-all").addEventListener("click", () => {
    if (!state.boxes.length) { alert("No boxes to print yet."); return; }
    const host = document.getElementById("print-label");
    while (host.firstChild) host.removeChild(host.firstChild);
    for (const b of state.boxes.slice().sort((a, x) => a.number - x.number)) buildLabel(host, b);
    document.body.classList.add("printing-label");
    window.print();
    const done = () => { document.body.classList.remove("printing-label"); window.removeEventListener("afterprint", done); };
    window.addEventListener("afterprint", done);
    setTimeout(() => document.body.classList.remove("printing-label"), 2000);
  });
  document.getElementById("export-btn").addEventListener("click", exportJSON);
  document.getElementById("import-btn").addEventListener("click", () => document.getElementById("import-file").click());
  document.getElementById("import-file").addEventListener("change", e => {
    if (e.target.files[0]) importJSON(e.target.files[0]);
    e.target.value = "";
  });
  document.getElementById("demo-btn").addEventListener("click", loadDemo);
  document.getElementById("clear-btn").addEventListener("click", () => {
    if (!window.confirm("Delete ALL boxes and items? Export a backup first if you need it.")) return;
    state = { boxes: [], customRooms: [], nextNumber: 101 };
    save(); renderAll(); runSearch();
    document.getElementById("nb-number").value = state.nextNumber;
  });
  document.getElementById("search-clear").addEventListener("click", () => {
    document.getElementById("search").value = "";
    runSearch();
    document.getElementById("search").focus();
  });
  let searchTimer = null;
  document.getElementById("search").addEventListener("input", () => {
    clearTimeout(searchTimer);
    searchTimer = setTimeout(runSearch, 120);
  });
}

// ---------- Render all ----------
function renderAll() {
  renderDashboard();
  renderBoxes();
  const st = document.getElementById("export-status");
  if (st) st.textContent = "";
}

// ---------- Init ----------
load();
initTheme();
refreshRoomSelect();
initNewBoxForm();
initToolbar();
document.getElementById("nb-number").value = state.nextNumber;
renderAll();
// keyboard focus for search (only when not on a small screen keyboard trap)
</script>
