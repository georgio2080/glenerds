      description: 'One white bathrobe missing from the closet hook.', photoNote: '',
      ts: now - 40 * 60000
    }
  ];
  return s;
}

/* ---------- render all + init ---------- */
function renderAll() {
  $('#prop-name').value = state.property || '';
  renderChecklist();
  renderLog();
}

document.addEventListener('DOMContentLoaded', function () {
  load();
  initTheme();
  initTabs();
  initChecklist();
  addResetButton();
  initLog();
  initData();
  renderAll();
  window.addEventListener('beforeunload', save);
  document.addEventListener('visibilitychange', function () {
    if (document.visibilityState === 'hidden') save();
  });
